<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_factory_sector_form_mix" model="ir.ui.view">
        <field name="name">factory.sector.form.mix</field>
        <field name="model">factory.sector</field>
        <field name="inherit_id" ref="factory_base.view_factory_sector_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Mix Design | تصميم الخلطة">
                    <group>
                        <group>
                            <field name="mix_id" options="{'no_create': True}"/>
                            <field name="mix_cost_per_unit" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_mix_cost" widget="monetary" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
