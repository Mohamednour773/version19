<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_notification_tree" model="ir.ui.view">
        <field name="name">club.notification.tree</field>
        <field name="model">club.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications" create="false">
                <field name="scheduled_date"/>
                <field name="name"/>
                <field name="notification_type"/>
                <field name="channel"/>
                <field name="partner_id"/>
                <field name="membership_id"/>
                <field name="session_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_club_notification_form" model="ir.ui.view">
        <field name="name">club.notification.form</field>
        <field name="model">club.notification</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <header>
                    <button name="action_mark_sent" string="Mark Sent" type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="notification_type"/>
                            <field name="channel"/>
                            <field name="scheduled_date"/>
                            <field name="sent_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="branch_id"/>
                            <field name="partner_id"/>
                            <field name="membership_id"/>
                            <field name="session_id"/>
                            <field name="waitlist_id"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_club_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">club.notification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
