<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_stock_request_user" model="res.groups">
        <field name="name">Stock Request User</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_stock_request_manager" model="res.groups">
        <field name="name">Stock Request Manager</field>
        <field name="implied_ids" eval="[(4, ref('inter_branch_stock_request.group_stock_request_user')), (4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="stock_request_company_rule_user" model="ir.rule">
        <field name="name">Stock Request multi-company access</field>
        <field name="model_id" ref="model_stock_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('inter_branch_stock_request.group_stock_request_user'))]"/>
    </record>

    <record id="stock_request_line_company_rule_user" model="ir.rule">
        <field name="name">Stock Request Line multi-company access</field>
        <field name="model_id" ref="model_stock_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('inter_branch_stock_request.group_stock_request_user'))]"/>
    </record>
</odoo>
