<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_request_list" model="ir.ui.view">
        <field name="name">universal.approval.request.list</field>
        <field name="model">universal.approval.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" decoration-success="state in ('approved', 'confirmed')" decoration-danger="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="res_name"/>
                <field name="workflow_id"/>
                <field name="owner_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="priority"/>
                <field name="state" widget="badge"/>
                <field name="pending_line_count"/>
                <field name="due_date"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_approval_request_form" model="ir.ui.view">
        <field name="name">universal.approval.request.form</field>
        <field name="model">universal.approval.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_approve_wizard" type="object" string="Approve" class="btn-primary" invisible="state != 'pending' or not can_current_user_approve"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject" class="btn-secondary" invisible="state != 'pending' or not can_current_user_approve"/>
                    <button name="action_open_modification_wizard" type="object" string="Request Modification" invisible="state != 'pending' or not can_current_user_approve"/>
                    <button name="action_open_forward_wizard" type="object" string="Forward" invisible="state != 'pending' or not can_current_user_approve"/>
                    <button name="action_open_withdraw_wizard" type="object" string="Withdraw" invisible="state not in ('pending', 'returned')"/>
                    <button name="action_resubmit" type="object" string="Re-Submit" class="btn-primary" invisible="state not in ('draft', 'returned', 'rejected', 'cancelled', 'withdrawn')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" groups="universal_approval_engine_19.group_approval_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,confirmed,rejected,returned,cancelled,withdrawn"/>
                </header>
                <sheet>
                    <field name="can_current_user_approve" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not anomaly_warning">
                        <field name="anomaly_warning" readonly="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not smart_suggestion">
                        <field name="smart_suggestion" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="workflow_id"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="res_name" readonly="1"/>
                            <field name="owner_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="currency_id"/>
                            <field name="priority"/>
                            <field name="current_stage_id"/>
                            <field name="submitted_date"/>
                            <field name="due_date"/>
                            <field name="document_changed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Live Tracker">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="state == 'approved'" decoration-warning="state == 'pending'" decoration-danger="state == 'rejected'" decoration-muted="state in ('future', 'skipped', 'cancelled')">
                                    <field name="sequence"/>
                                    <field name="stage_id"/>
                                    <field name="approver_id"/>
                                    <field name="original_approver_id"/>
                                    <field name="delegation_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="pending_date"/>
                                    <field name="due_date"/>
                                    <field name="decided_date"/>
                                    <field name="decision_user_id"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                        <page string="Discussion">
                            <field name="comment_ids">
                                <list editable="bottom">
                                    <field name="create_date"/>
                                    <field name="author_id"/>
                                    <field name="decision"/>
                                    <field name="reason_id"/>
                                    <field name="body"/>
                                    <field name="attachment_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Audit Trail">
                            <field name="audit_log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="event"/>
                                    <field name="user_id"/>
                                    <field name="message"/>
                                    <field name="ip_address"/>
                                    <field name="device"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical">
                            <group>
                                <field name="document_url" readonly="1"/>
                                <field name="snapshot_json" readonly="1"/>
                                <field name="latest_snapshot_json" readonly="1"/>
                                <field name="partner_key" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_approval_request_search" model="ir.ui.view">
        <field name="name">universal.approval.request.search</field>
        <field name="model">universal.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="res_name"/>
                <field name="owner_id"/>
                <field name="workflow_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ['approved', 'confirmed'])]"/>
                <filter name="rejected" string="Rejected" domain="[('state', 'in', ['rejected', 'cancelled'])]"/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_workflow" string="Workflow" context="{'group_by': 'workflow_id'}"/>
                    <filter name="group_owner" string="Requester" context="{'group_by': 'owner_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_approval_request_kanban" model="ir.ui.view">
        <field name="name">universal.approval.request.kanban</field>
        <field name="model">universal.approval.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="res_name"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="res_name"/></div>
                            <div><field name="amount_total"/> <field name="currency_id"/></div>
                            <div><field name="priority"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_approval_request_graph" model="ir.ui.view">
        <field name="name">universal.approval.request.graph</field>
        <field name="model">universal.approval.request</field>
        <field name="arch" type="xml">
            <graph string="Approval Analytics" type="bar">
                <field name="state"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_approval_request_pivot" model="ir.ui.view">
        <field name="name">universal.approval.request.pivot</field>
        <field name="model">universal.approval.request</field>
        <field name="arch" type="xml">
            <pivot string="Approval Analytics">
                <field name="workflow_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_approval_request_line_list" model="ir.ui.view">
        <field name="name">universal.approval.request.line.list</field>
        <field name="model">universal.approval.request.line</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="request_id"/>
                <field name="stage_id"/>
                <field name="approver_id"/>
                <field name="state" widget="badge"/>
                <field name="pending_date"/>
                <field name="due_date"/>
                <field name="decided_date"/>
            </list>
        </field>
    </record>

    <record id="view_approval_request_line_form" model="ir.ui.view">
        <field name="name">universal.approval.request.line.form</field>
        <field name="model">universal.approval.request.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="request_id"/>
                        <field name="stage_id"/>
                        <field name="sequence"/>
                        <field name="state" widget="badge"/>
                        <field name="approver_id"/>
                        <field name="original_approver_id"/>
                        <field name="delegation_id"/>
                        <field name="escalation_rule_id"/>
                        <field name="pending_date"/>
                        <field name="due_date"/>
                        <field name="decided_date"/>
                        <field name="decision_user_id"/>
                        <field name="reason_id"/>
                        <field name="comment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_approval_request_line_search" model="ir.ui.view">
        <field name="name">universal.approval.request.line.search</field>
        <field name="model">universal.approval.request.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="approver_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="mine" string="Mine" domain="[('approver_id', '=', uid)]"/>
                <group>
                    <filter name="group_approver" string="Approver" context="{'group_by': 'approver_id'}"/>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>


