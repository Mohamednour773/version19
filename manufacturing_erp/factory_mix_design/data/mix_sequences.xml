<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_factory_mix" model="ir.sequence">
            <field name="name">Mix Design | الخلطة</field>
            <field name="code">factory.mix</field>
            <field name="prefix">MIX/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_factory_mix_consumption" model="ir.sequence">
            <field name="name">Mix Consumption | استهلاك الخلطة</field>
            <field name="code">factory.mix.consumption</field>
            <field name="prefix">MCONS/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
