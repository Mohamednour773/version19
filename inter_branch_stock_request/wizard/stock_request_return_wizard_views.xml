<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_request_return_wizard_form" model="ir.ui.view">
        <field name="name">stock.request.return.wizard.form</field>
        <field name="model">stock.request.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Return">
                <sheet>
                    <group>
                        <field name="request_id"/>
                        <field name="reason" placeholder="Reason for the return"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0">
                            <field name="request_line_id" column_invisible="1" force_save="1"/>
                             <field name="product_id" readonly="1" force_save="1"/>
                             <field name="product_uom_id" readonly="1" force_save="1"/>
                             <field name="qty_available_return" readonly="1" force_save="1"/>
                             <field name="qty_to_return"/>
                             <field name="note" optional="show" readonly="1" force_save="1"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_return" string="Create Return" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
