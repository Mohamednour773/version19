<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_multi_currency" model="ir.ui.view">
        <field name="name">pos.config.form.multi.currency</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//div[contains(concat(' ', normalize-space(@class), ' '), ' o_settings_container ') and not(@id='restaurant_on_create')][1]" position="inside">
                <setting string="Multi-Currency Payments" help="Allow POS cashiers to accept selected foreign currencies.">
                    <field name="multi_currency_payment" readonly="has_active_session"/>
                    <div class="content-group mt16" invisible="not multi_currency_payment">
                        <field
                            name="multi_currency_ids"
                            widget="many2many_tags"
                            readonly="has_active_session"
                            options="{'no_create': True}"
                        />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
