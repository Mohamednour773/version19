<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_factory_stage_list" model="ir.ui.view">
        <field name="name">factory.stage.list</field>
        <field name="model">factory.stage</field>
        <field name="arch" type="xml">
            <list string="Manufacturing Stages | مراحل التصنيع">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="stage_type"/>
                <field name="default_duration_hours"/>
                <field name="default_labor_cost"/>
                <field name="currency_id" invisible="1"/>
                <field name="track_waste"/>
                <field name="requires_quality_check"/>
            </list>
        </field>
    </record>

    <record id="view_factory_stage_form" model="ir.ui.view">
        <field name="name">factory.stage.form</field>
        <field name="model">factory.stage</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Stage | مرحلة التصنيع">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="stage_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="default_duration_hours"/>
                            <field name="default_labor_cost"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="track_waste"/>
                            <field name="requires_quality_check"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Description | الوصف"/>
                    <field name="description" placeholder="Describe this stage... | اوصف هذه المرحلة..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_factory_stage" model="ir.actions.act_window">
        <field name="name">Manufacturing Stages | مراحل التصنيع</field>
        <field name="res_model">factory.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
