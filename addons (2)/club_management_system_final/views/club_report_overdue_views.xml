<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_overdue_tree" model="ir.ui.view">
        <field name="name">club.report.overdue.tree</field>
        <field name="model">club.report.overdue</field>
        <field name="arch" type="xml">
            <list string="Overdue Invoices" create="false" edit="false" delete="false">
                <field name="reference"/>
                <field name="branch_id"/>
                <field name="partner_id"/>
                <field name="source" widget="badge"/>
                <field name="invoice_id"/>
                <field name="due_date"/>
                <field name="days_overdue"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_residual" sum="Outstanding"/>
                <field name="payment_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_report_overdue_pivot" model="ir.ui.view">
        <field name="name">club.report.overdue.pivot</field>
        <field name="model">club.report.overdue</field>
        <field name="arch" type="xml">
            <pivot string="Overdue Invoices" disable_linking="True">
                <field name="branch_id" type="row"/>
                <field name="source" type="row"/>
                <field name="due_date" type="col" interval="month"/>
                <field name="amount_residual" type="measure"/>
                <field name="days_overdue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_report_overdue_search" model="ir.ui.view">
        <field name="name">club.report.overdue.search</field>
        <field name="model">club.report.overdue</field>
        <field name="arch" type="xml">
            <search string="Overdue Invoices">
                <field name="reference"/>
                <field name="branch_id"/>
                <field name="partner_id"/>
                <filter string="Memberships" name="membership" domain="[('source', '=', 'membership')]"/>
                <filter string="Rentals" name="rental" domain="[('source', '=', 'rental')]"/>
                <group>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Due Month" name="group_due_month" context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_overdue" model="ir.actions.act_window">
        <field name="name">Debts &amp; Overdue</field>
        <field name="res_model">club.report.overdue</field>
        <field name="view_mode">pivot,list</field>
        <field name="search_view_id" ref="view_report_overdue_search"/>
    </record>
</odoo>
