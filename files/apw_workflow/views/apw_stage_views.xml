<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_apw_stage_list" model="ir.ui.view">
        <field name="name">apw.stage.list</field>
        <field name="model">apw.stage</field>
        <field name="arch" type="xml">
            <list string="APW Approval Stages" default_order="config_id, sequence">
                <field name="sequence" widget="handle"/>
                <field name="config_id"/>
                <field name="name"/>
                <field name="approver_type"/>
                <field name="approver_display" string="Approver"/>
                <field name="allow_self_approval"/>
                <field name="auto_approve_if_missing"/>
            </list>
        </field>
    </record>

    <record id="view_apw_stage_form" model="ir.ui.view">
        <field name="name">apw.stage.form</field>
        <field name="model">apw.stage</field>
        <field name="arch" type="xml">
            <form string="APW Approval Stage">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Stage Name..."/></h1>
                    </div>
                    <group>
                        <group string="Stage Settings">
                            <field name="config_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Approver">
                            <field name="approver_type"/>
                            <field name="approver_user_id"
                                   invisible="approver_type != 'user'"
                                   required="approver_type == 'user'"/>
                            <field name="approver_group_id"
                                   invisible="approver_type != 'group'"
                                   required="approver_type == 'group'"/>
                            <field name="approver_field_id"
                                   invisible="approver_type != 'dynamic'"
                                   required="approver_type == 'dynamic'"/>
                            <field name="require_all_group_members"
                                   invisible="approver_type != 'group'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Behaviour">
                            <field name="allow_self_approval"/>
                            <field name="auto_approve_if_missing"/>
                            <field name="condition_domain"/>
                        </group>
                        <group string="Instructions for Approver">
                            <field name="description" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_apw_stage" model="ir.actions.act_window">
        <field name="name">APW Approval Stages</field>
        <field name="res_model">apw.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
