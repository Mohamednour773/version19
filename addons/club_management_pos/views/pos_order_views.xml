<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show the linked club membership on each POS order line -->
    <record id="view_pos_pos_form_club" model="ir.ui.view">
        <field name="name">pos.order.form.club</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <!-- Append membership column after the last column in the order lines list -->
            <xpath expr="//field[@name='lines']//list//field[@name='refunded_qty']" position="after">
                <field name="club_membership_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
