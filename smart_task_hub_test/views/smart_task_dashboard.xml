<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Action -->
    <record id="action_smart_task_dashboard" model="ir.actions.act_window">
        <field name="name">📊 Smart Task Dashboard</field>
        <field name="res_model">smart.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{
            'search_default_group_priority': 1
        }</field>
    </record>

    <!-- AI Cost Report Action -->
    <record id="action_smart_ai_cost_report" model="ir.actions.act_window">
        <field name="name">💰 AI Cost Report</field>
        <field name="res_model">smart.ai.log</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
