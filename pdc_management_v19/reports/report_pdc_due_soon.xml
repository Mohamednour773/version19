<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         PDC DUE SOON REPORT
         Checks whose due date falls within pdc_due_soon_days of the
         wizard's as_of_date (default: 7 days, configurable in Settings).
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Wizard form view ──────────────────────────────────────────────── -->
    <record id="view_pdc_due_soon_wizard_form" model="ir.ui.view">
        <field name="name">pdc.list.report.wizard.due_soon.form</field>
        <field name="model">pdc.list.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Checks Due Soon">
                <group>
                    <group>
                        <field name="report_type" invisible="1"/>
                        <field name="as_of_date"/>
                        <field name="check_type_filter"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Filter by Partners (optional)">
                        <field name="partner_ids"
                               nolabel="1"
                               widget="many2many_tags"
                               placeholder="Leave empty for all partners…"/>
                    </group>
                </group>
                <p class="text-muted" style="font-size:9pt; margin:0 0 8px 0;">
                    The "Due Soon" threshold is configured in
                    PDC Management → Configuration → Settings
                    (Due Soon Threshold field).
                </p>
                <footer>
                    <button name="action_print"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"
                            data-hotkey="p"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Window action ─────────────────────────────────────────────────── -->
    <record id="action_pdc_due_soon_wizard" model="ir.actions.act_window">
        <field name="name">Due Soon Report</field>
        <field name="res_model">pdc.list.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pdc_due_soon_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'due_soon'}</field>
    </record>

    <!-- ── ir.actions.report ─────────────────────────────────────────────── -->
    <record id="action_report_pdc_due_soon" model="ir.actions.report">
        <field name="name">Checks Due Soon</field>
        <field name="model">pdc.list.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pdc_management_v19.report_pdc_due_soon_document</field>
        <field name="report_file">pdc_management_v19.report_pdc_due_soon_document</field>
        <field name="print_report_name">'Due Soon ' + str(object.as_of_date)</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ── QWeb template ─────────────────────────────────────────────────── -->
    <template id="report_pdc_due_soon_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">

                    <div class="text-center mb-3">
                        <h3><strong>CHECKS DUE SOON</strong></h3>
                        <p class="text-muted mb-0">
                            As of <strong><t t-out="wizard.as_of_date"/></strong>
                            — <t t-out="wizard.company_id.name"/>
                        </p>
                        <p class="text-muted" style="font-size:9pt;">
                            Threshold: <t t-out="wizard.company_id.pdc_due_soon_days or 7"/> days
                        </p>
                    </div>

                    <t t-if="not checks">
                        <p class="text-center text-muted">
                            <em>No checks due soon.</em>
                        </p>
                    </t>

                    <t t-if="checks">
                        <!-- Summary cards -->
                        <div class="row mb-3">
                            <div class="col-4">
                                <div class="card text-center">
                                    <div class="card-body py-2">
                                        <h5 class="card-title mb-0">
                                            <t t-out="len(checks)"/>
                                        </h5>
                                        <small class="text-muted">Total Checks</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="card text-center">
                                    <div class="card-body py-2">
                                        <h5 class="card-title mb-0">
                                            <t t-out="'{:,.2f}'.format(sum(c.amount for c in checks))"/>
                                        </h5>
                                        <small class="text-muted">Total Amount</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="card text-center">
                                    <div class="card-body py-2">
                                        <h5 class="card-title mb-0">
                                            <t t-out="len(set(c.partner_id.id for c in checks))"/>
                                        </h5>
                                        <small class="text-muted">Partners</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <table class="table table-bordered table-sm table-hover" style="font-size:8.5pt;">
                            <thead style="background:#1F4E79; color:white;">
                                <tr>
                                    <th>#</th>
                                    <th>Reference</th>
                                    <th>Check No.</th>
                                    <th>Partner</th>
                                    <th>Bank</th>
                                    <th>Type</th>
                                    <th>State</th>
                                    <th>Issue Date</th>
                                    <th>Due Date</th>
                                    <th>Days Left</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="idx" t-value="0"/>
                                <t t-foreach="checks" t-as="chk">
                                    <t t-set="idx" t-value="idx + 1"/>
                                    <t t-set="days_left"
                                       t-value="(chk.due_date - wizard.as_of_date).days if chk.due_date else 0"/>
                                    <tr t-att-class="'table-danger' if days_left &lt;= 1 else (
                                                    'table-warning' if days_left &lt;= 3 else '')">
                                        <td><t t-out="idx"/></td>
                                        <td><t t-out="chk.name or ''"/></td>
                                        <td><t t-out="chk.check_number or ''"/></td>
                                        <td><t t-out="chk.partner_id.name if chk.partner_id else ''"/></td>
                                        <td><t t-out="chk.bank_id.name if chk.bank_id else ''"/></td>
                                        <td>
                                            <t t-out="dict(chk._fields['check_type'].selection).get(chk.check_type, '')"/>
                                        </td>
                                        <td>
                                            <t t-out="dict(chk._fields['state'].selection).get(chk.state, chk.state)"/>
                                        </td>
                                        <td>
                                            <t t-out="chk.issue_date.strftime('%d/%m/%Y') if chk.issue_date else ''"/>
                                        </td>
                                        <td class="fw-bold">
                                            <t t-out="chk.due_date.strftime('%d/%m/%Y') if chk.due_date else ''"/>
                                        </td>
                                        <td class="text-center fw-bold">
                                            <t t-out="days_left"/>
                                        </td>
                                        <td class="text-end fw-bold">
                                            <t t-out="'{:,.2f}'.format(chk.amount)"/>
                                            <small class="text-muted ms-1">
                                                <t t-out="chk.currency_id.name if chk.currency_id else ''"/>
                                            </small>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background:#D6E4F0; font-weight:bold;">
                                    <td colspan="10" class="text-end">Total:</td>
                                    <td class="text-end">
                                        <t t-out="'{:,.2f}'.format(sum(c.amount for c in checks))"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <p style="font-size:8pt;" class="text-muted mt-1">
                            <span class="badge bg-danger">&#9632;</span> Due tomorrow or today
                            <span class="ms-3 badge" style="background:#ffc107; color:#000;">&#9632;</span>
                            Due within 3 days
                        </p>
                    </t>

                </div>
            </t>
        </t>
    </template>

</odoo>
