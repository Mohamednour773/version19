<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================================================
         Approval Stage - List View
    ==================================================================== -->
    <record id="view_approval_stage_list" model="ir.ui.view">
        <field name="name">approval.stage.list</field>
        <field name="model">approval.stage</field>
        <field name="arch" type="xml">
            <list string="Approval Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="cycle_id"/>
                <field name="approval_type"/>
                <field name="require_all"/>
                <field name="notify_approvers"/>
            </list>
        </field>
    </record>

    <!-- ====================================================================
         Approval Stage - Form View
    ==================================================================== -->
    <record id="view_approval_stage_form" model="ir.ui.view">
        <field name="name">approval.stage.form</field>
        <field name="model">approval.stage</field>
        <field name="arch" type="xml">
            <form string="Approval Stage">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Stage Name..." required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Stage Info">
                            <field name="cycle_id" required="1"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Approval Logic">
                            <field name="require_all"/>
                            <field name="allow_self_approval"/>
                        </group>
                    </group>
                    <group string="Approver Configuration">
                        <field name="approval_type" required="1"/>
                        <field name="approver_ids"
                               widget="many2many_tags"
                               invisible="approval_type != 'user'"/>
                        <field name="approver_group_id"
                               invisible="approval_type != 'group'"/>
                        <field name="dynamic_approver_field_id"
                               invisible="approval_type != 'dynamic'"/>
                    </group>
                    <group string="Notifications">
                        <field name="notify_approvers"/>
                        <field name="email_template_id"
                               invisible="not notify_approvers"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Instructions for approvers at this stage..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_approval_stage" model="ir.actions.act_window">
        <field name="name">Approval Stages</field>
        <field name="res_model">approval.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
