<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_outstanding_custodies">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" dir="rtl" style="font-family: Arial, sans-serif;">
                    <div class="text-center mb-4">
                        <h2 style="color: #2c5282;">تقرير العهد غير المسوّاة</h2>
                        <h4>Outstanding Custodies Report</h4>
                        <hr/>
                    </div>
                    <table class="table table-bordered table-sm">
                        <thead class="table-primary">
                            <tr>
                                <th>رقم العهدة</th>
                                <th>الموظف</th>
                                <th>الصندوق</th>
                                <th>المبلغ المصروف</th>
                                <th>تاريخ الاسترداد</th>
                                <th>أيام التأخير</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <t t-set="days_overdue" t-value="(context_today() - o.expected_return_date).days if o.expected_return_date else 0"/>
                                <tr t-attf-style="background-color: #{
                                    '#ffcccc' if days_overdue > 14 else
                                    '#fff3cd' if days_overdue > 7 else
                                    '#d4edda'
                                }">
                                    <td><t t-esc="o.name"/></td>
                                    <td><t t-esc="o.employee_id.name"/></td>
                                    <td><t t-esc="o.petty_fund_id.name"/></td>
                                    <td><t t-esc="o.currency_id.format(o.paid_amount)"/></td>
                                    <td><t t-esc="o.expected_return_date or 'N/A'"/></td>
                                    <td><t t-esc="days_overdue if days_overdue > 0 else '-'"/></td>
                                    <td><t t-esc="dict(o._fields['state'].selection).get(o.state)"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div class="mt-2">
                        <span class="badge" style="background:#d4edda;color:#000;">■ أقل من 7 أيام</span>
                        <span class="badge ms-2" style="background:#fff3cd;color:#000;">■ 7-14 يوم</span>
                        <span class="badge ms-2" style="background:#ffcccc;color:#000;">■ أكثر من 14 يوم</span>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
