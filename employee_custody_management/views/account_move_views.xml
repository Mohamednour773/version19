<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form_custody" model="ir.ui.view">
        <field name="name">account.move.form.custody</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_custody_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="custody_payment_count == 0 or move_type not in ('in_invoice', 'in_refund')">
                    <field name="custody_payment_count" widget="statinfo" string="Custody Payments"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='payment_state']" position="after">
                <field name="custody_payment_count" invisible="1"/>
                <field name="custody_paid_amount"
                       widget="monetary"
                       readonly="1"
                       invisible="custody_paid_amount == 0 or move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
