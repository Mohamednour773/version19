<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_factory_loading_permit_list" model="ir.ui.view">
        <field name="name">factory.loading.permit.list</field>
        <field name="model">factory.loading.permit</field>
        <field name="arch" type="xml">
            <list string="Loading Permits | أذون التحميل"
                  decoration-info="state == 'confirmed'"
                  decoration-success="state == 'loaded'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="sector_id"/>
                <field name="vehicle_number"/>
                <field name="driver_name"/>
                <field name="total_quantity"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_factory_loading_permit_form" model="ir.ui.view">
        <field name="name">factory.loading.permit.form</field>
        <field name="model">factory.loading.permit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm | تأكيد"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_load" string="Mark Loaded | تم التحميل"
                            type="object" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel | إلغاء"
                            type="object"
                            invisible="state in ('loaded','cancelled')"/>
                    <button name="action_reset" string="Reset | إعادة"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Project | المشروع">
                            <field name="project_id"/>
                            <field name="sector_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Vehicle | السيارة">
                            <field name="vehicle_number"/>
                            <field name="driver_name"/>
                            <field name="driver_phone"/>
                            <field name="destination"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items | البنود">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_quantity"/>
                            </group>
                        </page>
                        <page string="Notes | ملاحظات">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_factory_loading_permit" model="ir.actions.act_window">
        <field name="name">Loading Permits | أذون التحميل</field>
        <field name="res_model">factory.loading.permit</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
