    <!-- ── NBE — National Bank of Egypt ─────────────────────────────────── -->
    <!-- COORDINATES UNVERIFIED — Test on actual bank check paper before production use -->
    <!--
        NBE check field zones (measured from specimen):
          Date area   : right side, ~165 mm from left, ~22 mm from top
          Payee line  : ~45 mm from left, ~38 mm from top
          Amount words: ~40 mm from left, ~52 mm from top  (max ~130 mm wide)
          Amount figs : box at ~168 mm from left, ~52 mm from top
          City line   : ~45 mm from left, ~22 mm from top
    -->
    <record id="layout_nbe_default" model="pdc.bank.layout">
        <field name="name">NBE — Standard Business Check</field>
        <field name="bank_id" ref="bank_nbe"/>
        <field name="is_default">True</field>
        <field name="active">True</field>
        <field name="paper_format">custom</field>
        <field name="paper_width">220.0</field>
        <field name="paper_height">96.0</field>
        <field name="orientation">landscape</field>
        <field name="date_x">165.0</field>
        <field name="date_y">22.0</field>
        <field name="date_format">DD/MM/YYYY</field>
        <field name="payee_x">45.0</field>
        <field name="payee_y">38.0</field>
        <field name="amount_words_x">40.0</field>
        <field name="amount_words_y">52.0</field>
        <field name="amount_words_max_width">128.0</field>
        <field name="amount_numbers_x">168.0</field>
        <field name="amount_numbers_y">52.0</field>
        <field name="city_x">45.0</field>
        <field name="city_y">22.0</field>
        <field name="font_size">11</field>
        <field name="font_family">Arial</field>
        <field name="use_arabic">False</field>
    </record>

