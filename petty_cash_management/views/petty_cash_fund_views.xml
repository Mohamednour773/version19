<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Fund Form ─────────────────────────────────────────────────────── -->
    <record id="view_petty_cash_fund_form" model="ir.ui.view">
        <field name="name">petty.cash.fund.form</field>
        <field name="model">petty.cash.fund</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Fund | صندوق البيتي كاش">
                <header>
                    <button name="action_suspend" string="Suspend / تعليق"
                        type="object" class="btn-warning"
                        invisible="state != 'active'"
                        groups="petty_cash_management.group_petty_cash_admin"/>
                    <button name="action_reactivate" string="Reactivate / تفعيل"
                        type="object" class="btn-success"
                        invisible="state != 'suspended'"
                        groups="petty_cash_management.group_petty_cash_admin"/>
                    <button name="action_close" string="Close Fund / إغلاق الصندوق"
                        type="object" class="btn-danger"
                        invisible="state == 'closed'"
                        groups="petty_cash_management.group_petty_cash_admin"
                        confirm="Are you sure you want to close this fund?"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="active,suspended,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_custodies" type="object"
                            class="oe_stat_button" icon="fa-users">
                            <field name="custody_count" widget="statinfo" string="Custodies"/>
                        </button>
                        <button name="action_view_transfers" type="object"
                            class="oe_stat_button" icon="fa-exchange">
                            <field name="transfer_count" widget="statinfo" string="Transfers"/>
                        </button>
                        <button name="action_view_payments" type="object"
                            class="oe_stat_button" icon="fa-credit-card">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Fund Name..."/></h1>
                        <h2><field name="name_ar" placeholder="اسم الصندوق..."/></h2>
                    </div>
                    <group>
                        <group string="Fund Details">
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="custodian_id"/>
                            <field name="branch_name"/>
                        </group>
                        <group string="Balance / الأرصدة">
                            <field name="current_balance" widget="monetary"/>
                            <field name="max_balance" widget="monetary"/>
                            <field name="min_balance" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Accounting Configuration">
                        <group>
                            <field name="journal_id"/>
                            <field name="account_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes / ملاحظات..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ─── Fund List ─────────────────────────────────────────────────────── -->
    <record id="view_petty_cash_fund_list" model="ir.ui.view">
        <field name="name">petty.cash.fund.list</field>
        <field name="model">petty.cash.fund</field>
        <field name="arch" type="xml">
            <list string="Petty Cash Funds" decoration-danger="state == 'closed'"
                decoration-warning="state == 'suspended'">
                <field name="code"/>
                <field name="name"/>
                <field name="name_ar"/>
                <field name="custodian_id"/>
                <field name="journal_id"/>
                <field name="current_balance" widget="monetary"/>
                <field name="min_balance" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'active'"
                    decoration-warning="state == 'suspended'"
                    decoration-danger="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ─── Fund Action ───────────────────────────────────────────────────── -->
    <record id="action_petty_cash_fund" model="ir.actions.act_window">
        <field name="name">Petty Cash Funds | صناديق البيتي كاش</field>
        <field name="res_model">petty.cash.fund</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_petty_cash_fund_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Petty Cash Fund
            </p>
            <p>أنشئ صندوق البيتي كاش الأول لمؤسستك</p>
        </field>
    </record>

</odoo>
