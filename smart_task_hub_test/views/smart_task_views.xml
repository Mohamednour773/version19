<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════
         FORM VIEW — Smart Task Hub v2
    ═════════════════════════════════════════════════ -->
    <record id="smart_task_form_view" model="ir.ui.view">
        <field name="name">smart.task.form</field>
        <field name="model">smart.task</field>
        <field name="arch" type="xml">
            <form string="Smart Task">
                <!-- Hidden fields needed for invisible modifiers -->
                <field name="is_duplicate_flagged" invisible="1"/>
                <field name="project_task_id"      invisible="1"/>
                <field name="helpdesk_ticket_id"   invisible="1"/>
                <field name="risk_flags"            invisible="1"/>
                <field name="similar_kb_ids"        invisible="1"/>
                <field name="screenshot_filename"      invisible="1"/>
                <field name="screenshot_image"         invisible="1"/>

                <header>
                    <button name="action_analyze_with_ai"
                            string="🤖 Analyze with AI"
                            type="object" class="btn-primary"
                            invisible="ai_status in ('analyzing', 'reviewed')"/>
                    <button name="action_analyze_screenshot"
                            string="🖼️ Analyze Screenshot"
                            type="object" class="btn-secondary"
                            invisible="not screenshot_image"/>
                    <button name="action_retry_analysis"
                            string="🔄 Retry AI Analysis"
                            type="object"
                            invisible="ai_status not in ('failed', 'reviewed')"/>
                    <button name="action_create_project_task"
                            string="📋 Create Project Task"
                            type="object"
                            invisible="not project_task_id"/>
                    <button name="action_create_helpdesk_ticket"
                            string="🎫 Create HD Ticket"
                            type="object"
                            invisible="not helpdesk_ticket_id"/>
                    <button name="action_mark_done"
                            string="✅ Mark Done"
                            type="object" class="btn-success"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_analysis,in_progress,review,done"/>
                </header>

                <sheet>
                    <!-- DUPLICATE ALERT -->
                    <div class="alert alert-warning mb-2" role="alert"
                         invisible="not is_duplicate_flagged">
                        <strong>⚠️ Possible Duplicate Detected!</strong>
                        Similar open tasks exist for this client.
                    </div>

                    <!-- KB MATCH ALERT -->
                    <div class="alert alert-info mb-2" role="alert"
                         invisible="not similar_kb_ids">
                        <strong>📚 Similar KB Articles Found!</strong>
                        Check the KB tab — a solution may already exist.
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Task Title..."/></h1>
                    </div>

                    <!-- ROW 1: Task Info + Classification -->
                    <group>
                        <group string="📋 Task Information">
                            <field name="client_id"/>
                            <field name="project_id"/>
                            <field name="assigned_to"/>
                            <field name="assignment_type"/>
                        </group>
                        <group string="🏷️ Classification">
                            <field name="priority_level"/>
                            <field name="priority_score"/>
                            <field name="odoo_module"/>
                            <field name="task_type"/>
                            <field name="complexity"/>
                            <field name="solution_type"/>
                            <field name="root_cause"/>
                        </group>
                    </group>

                    <!-- ROW 2: Effort + AI Status -->
                    <group>
                        <group string="⏱️ Effort, Risk &amp; SLA">
                            <field name="effort_estimate"/>
                            <field name="effort_category"/>
                            <field name="risk_level"/>
                            <field name="sla_hours"/>
                            <field name="escalation_rule"/>
                        </group>
                        <group string="🤖 AI Status">
                            <field name="ai_status"/>
                            <field name="analysis_date"/>
                            <field name="knowledge_base_id"/>
                        </group>
                    </group>

                    <!-- Voice Input (Whisper) -->
                    <group>
                        <field name="voice_input_control" widget="voice_recorder"
                               string="🎤 Voice Input" nolabel="1"/>
                    </group>

                    <!-- Description -->
                    <field name="description"
                           placeholder="Describe the task or issue in detail..."/>

                    <!-- Screenshot for GPT-4V Analysis -->
                    <group string="Screenshot Analysis">
                        <field name="screenshot_image" widget="image"
                               string="Upload Screenshot"
                               filename="screenshot_filename"/>
                    </group>

                    <!-- Risk flags (shown only when filled) -->
                    <group invisible="not risk_flags">
                        <field name="risk_flags"
                               string="⚠️ Risk Details" readonly="1"/>
                    </group>

                    <!-- ════ AI ANALYSIS TABS ════ -->
                    <notebook invisible="ai_status == 'pending'">

                        <page string="Screenshot Analysis"
                              invisible="not screenshot_analysis">
                            <field name="screenshot_analysis" readonly="1"
                                   string="GPT-4V Extracted Data"/>
                        </page>

                        <page string="📊 Executive Summary">
                            <field name="ai_summary" readonly="1"/>
                        </page>

                        <page string="🔍 GPT Analysis">
                            <group string="Functional Analysis + Root Causes">
                                <field name="gpt_analysis" nolabel="1" readonly="1"/>
                            </group>
                            <group string="Proposed Solution">
                                <field name="gpt_solution" nolabel="1" readonly="1"/>
                            </group>
                        </page>

                        <page string="⚡ Auto Fix">
                            <field name="auto_fix_suggestions"
                                   nolabel="1" readonly="1"/>
                        </page>

                        <page string="🛡️ Claude Audit">
                            <field name="claude_review"
                                   nolabel="1" readonly="1"/>
                        </page>

                        <page string="📧 Client Communication">
                            <field name="client_communication"
                                   nolabel="1" readonly="1"/>
                        </page>

                        <page string="🧪 Test Cases">
                            <field name="test_cases"
                                   nolabel="1" readonly="1"/>
                        </page>

                        <page string="📐 Gap Analysis">
                            <field name="gap_analysis_notes"
                                   nolabel="1" readonly="1"/>
                        </page>

                        <page string="📚 KB Entry Draft">
                            <field name="kb_entry" nolabel="1" readonly="1"/>
                        </page>

                        <page string="🔗 Similar KB Articles"
                              invisible="not similar_kb_ids">
                            <field name="similar_kb_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="odoo_module"/>
                                    <field name="task_type"/>
                                    <field name="complexity"/>
                                </list>
                            </field>
                        </page>

                        <page string="⚠️ Duplicates"
                              invisible="not is_duplicate_flagged">
                            <field name="duplicate_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="client_id"/>
                                    <field name="priority_level"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                    </notebook>

                    <!-- Linked Records -->
                    <group string="🔗 Linked Records"
                           invisible="not project_task_id and not helpdesk_ticket_id">
                        <field name="project_task_id"    readonly="1"/>
                        <field name="helpdesk_ticket_id" readonly="1"/>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════
         LIST VIEW
    ═════════════════════════════════════════════════ -->
    <record id="smart_task_list_view" model="ir.ui.view">
        <field name="name">smart.task.list</field>
        <field name="model">smart.task</field>
        <field name="arch" type="xml">
            <list string="Smart Tasks"
                  decoration-danger="priority_level == '1_critical'"
                  decoration-warning="priority_level == '2_high'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="priority_level"/>
                <field name="priority_score"/>
                <field name="odoo_module"/>
                <field name="task_type"/>
                <field name="complexity"/>
                <field name="assignment_type"/>
                <field name="assigned_to" widget="many2one_avatar_user"/>
                <field name="effort_estimate"/>
                <field name="sla_hours" optional="show"/>
                <field name="risk_level"/>
                <field name="ai_status"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancelled'"
                       decoration-warning="state == 'in_analysis'"
                       decoration-info="state == 'in_progress'"/>
                <field name="is_duplicate_flagged" optional="show"/>
            </list>
        </field>
    </record>



    <!-- ════════════════════════════════════════════════
         AI LOG VIEW
    ═════════════════════════════════════════════════ -->

    <record id="action_smart_task" model="ir.actions.act_window">
        <field name="name">Smart Tasks</field>
        <field name="res_model">smart.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
    </record>
    <record id="action_smart_task_critical" model="ir.actions.act_window">
        <field name="name">🔴 Critical Tasks</field>
        <field name="res_model">smart.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('priority_level','=','1_critical')]</field>
    </record>
</odoo>