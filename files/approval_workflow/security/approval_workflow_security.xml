<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Security Categories -->
        <record id="module_approval_workflow_category" model="ir.module.category">
            <field name="name">Approval Workflow</field>
            <field name="sequence">100</field>
        </record>

        <!-- Approval User: Can submit requests and approve their own lines -->
        <record id="group_approval_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_approval_workflow_category"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Approval Manager: Can configure workflows -->
        <record id="group_approval_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_approval_workflow_category"/>
            <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
