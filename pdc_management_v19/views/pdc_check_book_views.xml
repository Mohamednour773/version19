<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="view_pdc_check_book_list" model="ir.ui.view">
        <field name="name">pdc.check.book.list</field>
        <field name="model">pdc.check.book</field>
        <field name="arch" type="xml">
            <list string="Check Books"
                  decoration-success="state == 'active'"
                  decoration-muted="state == 'archived'"
                  decoration-warning="state == 'depleted'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="journal_id"/>
                <field name="bank_id"/>
                <field name="start_number"/>
                <field name="end_number"/>
                <field name="total_checks"/>
                <field name="used_checks"/>
                <field name="available_checks"/>
                <field name="issue_date"/>
                <field name="state"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'archived'"
                       decoration-warning="state == 'depleted'"
                       decoration-info="state == 'draft'"
                       widget="badge"/>
                <field name="low_stock_alert" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="view_pdc_check_book_form" model="ir.ui.view">
        <field name="name">pdc.check.book.form</field>
        <field name="model">pdc.check.book</field>
        <field name="arch" type="xml">
            <form string="Check Book">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="pdc_management_v19.group_pdc_manager"/>
                    <button name="action_archive_book" string="Archive"
                            type="object"
                            invisible="state not in ('active', 'depleted')"
                            groups="pdc_management_v19.group_pdc_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,depleted,archived"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_checks"
                                type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="used_checks == 0">
                            <field name="used_checks" widget="statinfo" string="Checks Used"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-square-o" type="object"
                                name="action_view_checks"
                                invisible="total_checks == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="available_checks"/>
                                </span>
                                <span class="o_stat_text">Available</span>
                            </div>
                        </button>
                    </div>

                    <!-- low_stock_alert must be declared for the invisible modifier -->
                    <field name="low_stock_alert" invisible="1"/>

                    <!-- Low Stock Warning -->
                    <div class="alert alert-warning mb-3"
                         role="alert"
                         invisible="not low_stock_alert">
                        Running low on checks — only
                        <field name="available_checks" readonly="1" nolabel="1"
                               class="fw-bold d-inline"/> checks remaining.
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>

                    <group>
                        <group string="Bank / Journal">
                            <field name="journal_id"
                                   readonly="state != 'draft'"/>
                            <field name="bank_id"
                                   readonly="state != 'draft'"/>
                            <field name="layout_id"
                                   domain="[('bank_id', '=', bank_id)]"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Check Numbers">
                            <field name="start_number"
                                   readonly="state != 'draft'"/>
                            <field name="end_number"
                                   readonly="state != 'draft'"/>
                            <field name="total_checks"/>
                            <field name="next_number"
                                   invisible="state not in ('active',)"/>
                        </group>
                    </group>

                    <group>
                        <group string="Usage Statistics">
                            <field name="used_checks"/>
                            <field name="cancelled_checks"/>
                            <field name="available_checks"/>
                            <field name="low_stock_threshold"/>
                        </group>
                        <group string="Details">
                            <field name="issue_date"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1"
                               placeholder="Internal notes about this check book..."/>
                    </group>

                    <!-- Checks Tab -->
                    <notebook invisible="used_checks == 0">
                        <page string="Checks" name="checks">
                            <field name="check_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="check_number"/>
                                    <field name="partner_id"/>
                                    <field name="amount"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state in ('cleared','paid','settled')"
                                           decoration-danger="state in ('bounced','cancelled')"
                                           decoration-info="state in ('draft','registered')"
                                           decoration-warning="state in ('under_collection','delivered','printed')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Kanban View ───────────────────────────────────────────────────── -->
    <record id="view_pdc_check_book_kanban" model="ir.ui.view">
        <field name="name">pdc.check.book.kanban</field>
        <field name="model">pdc.check.book</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="journal_id"/>
                <field name="state"/>
                <field name="available_checks"/>
                <field name="total_checks"/>
                <field name="used_checks"/>
                <field name="low_stock_alert"/>
                <field name="issue_date"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <span t-if="record.low_stock_alert.raw_value"
                                  class="badge text-bg-warning ms-1">
                                Low Stock
                            </span>
                        </div>
                        <div class="text-muted small">
                            <field name="bank_id"/> — <field name="journal_id"/>
                        </div>
                        <div class="mt-2 d-flex gap-3">
                            <div>
                                <span class="fw-bold"><field name="available_checks"/></span>
                                <span class="text-muted small"> / <field name="total_checks"/> available</span>
                            </div>
                        </div>
                        <div class="text-muted small mt-1">
                            Received: <field name="issue_date"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────────────── -->
    <record id="view_pdc_check_book_search" model="ir.ui.view">
        <field name="name">pdc.check.book.search</field>
        <field name="model">pdc.check.book</field>
        <field name="arch" type="xml">
            <search string="Search Check Books">
                <field name="name" string="Reference"/>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────── -->
    <record id="action_pdc_check_book" model="ir.actions.act_window">
        <field name="name">Check Books</field>
        <field name="res_model">pdc.check.book</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active_books': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No check books yet.
            </p>
            <p>
                Register your issued check books to track check numbers and
                automatically assign numbers when creating issued checks.
            </p>
        </field>
    </record>

    <!-- ── Action: checks from book (for smart button) ───────────────────── -->
    <record id="action_pdc_check_from_book" model="ir.actions.act_window">
        <field name="name">Checks</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_book_id', '=', active_id)]</field>
        <field name="context">{'default_check_book_id': active_id}</field>
    </record>

</odoo>
