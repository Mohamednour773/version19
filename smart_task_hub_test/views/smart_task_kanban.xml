<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="smart_task_kanban_view" model="ir.ui.view">
        <field name="name">smart.task.kanban</field>
        <field name="model">smart.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="priority_level" class="o_kanban_small_column"
                    records_draggable="true" quick_create="false">
                <field name="name"/>
                <field name="client_id"/>
                <field name="priority_level"/>
                <field name="odoo_module"/>
                <field name="assigned_to"/>
                <field name="ai_status"/>
                <field name="effort_estimate"/>
                <field name="risk_level"/>
                <field name="state"/>
                <field name="color"/>
                <field name="is_duplicate_flagged"/>
                <templates>
                    <t t-name="kanban-card">
                        <div class="oe_kanban_content">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="badge"
                                      t-att-class="{
                                          'bg-danger':  record.priority_level.raw_value == '1_critical',
                                          'bg-warning': record.priority_level.raw_value == '2_high',
                                          'bg-info':    record.priority_level.raw_value == '3_medium',
                                          'bg-success': record.priority_level.raw_value == '4_low'
                                      }">
                                    <field name="priority_level"/>
                                </span>
                                <span t-if="record.is_duplicate_flagged.raw_value"
                                      class="badge bg-warning">⚠️ Dup</span>
                            </div>
                            <strong><field name="name"/></strong>
                            <div class="text-muted small mt-1">
                                🏢 <field name="client_id"/>
                            </div>
                            <div class="text-muted small">
                                <t t-if="record.odoo_module.raw_value">
                                    📦 <field name="odoo_module"/>
                                </t>
                            </div>
                            <div class="d-flex justify-content-between mt-2 align-items-center">
                                <span class="badge bg-secondary small">
                                    <field name="ai_status"/>
                                </span>
                                <div class="d-flex align-items-center">
                                    <t t-if="record.effort_estimate.raw_value">
                                        <span class="text-muted small me-2">
                                            ⏱️ <field name="effort_estimate"/>h
                                        </span>
                                    </t>
                                    <field name="assigned_to" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
