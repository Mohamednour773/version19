<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_multi_currency_19.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'payment-buttons')]" position="inside">
            <button
                t-if="showMultiCurrencyButton"
                class="button btn btn-secondary btn-lg pos-multi-currency-button"
                t-on-click="selectMultiCurrencyPayment"
            >
                <i class="fa fa-exchange me-2" />
                <span>Currency</span>
            </button>
        </xpath>
    </t>

    <t t-name="pos_multi_currency_19.PaymentLineCurrencyLabel" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'payment-infos')]/div[contains(@class, 'payment-amount')]" position="before">
            <div t-if="line.getMultiCurrencyLabel()" class="pos-multi-currency-label text-nowrap">
                <t t-esc="line.getMultiCurrencyLabel()"/>
            </div>
        </xpath>
    </t>

    <t t-name="pos_multi_currency_19.OrderReceiptPaymentCurrency" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'paymentlines')]/span[contains(@class, 'pos-receipt-right-align')]" position="before">
            <span t-if="line.getMultiCurrencyLabel()" class="pos-multi-currency-receipt-label">
                <t t-esc="line.getMultiCurrencyLabel()"/>
            </span>
        </xpath>
    </t>

    <t t-name="pos_multi_currency_19.ClosePosPopupForeignCash" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='props.default_cash_details.payment_amount']" position="after">
            <t t-foreach="props.default_cash_details.multi_currency_summary || []" t-as="currency" t-key="currency.currency">
                <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2 pos-multi-currency-closing-line">
                    <span>
                        <t t-esc="currency.currency"/> tendered
                    </span>
                    <span>
                        <t t-esc="currency.foreign_amount.toFixed(2)"/> <t t-esc="currency.symbol || currency.currency"/>
                    </span>
                </div>
            </t>
        </xpath>
    </t>

    <t t-name="pos_multi_currency_19.ClosePosPopupForeignNonCash" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[@t-foreach='props.non_cash_payment_methods']/div[contains(@class, 'fs-3')]" position="after">
            <t t-foreach="pm.multi_currency_summary || []" t-as="currency" t-key="currency.currency">
                <div class="d-flex align-items-center justify-content-between text-muted border-start ps-2 pos-multi-currency-closing-line">
                    <span>
                        <t t-esc="currency.currency"/> tendered
                    </span>
                    <span>
                        <t t-esc="currency.foreign_amount.toFixed(2)"/> <t t-esc="currency.symbol || currency.currency"/>
                    </span>
                </div>
            </t>
        </xpath>
    </t>
</templates>
