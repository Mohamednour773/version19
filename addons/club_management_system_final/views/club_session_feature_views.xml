<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_session_form_features" model="ir.ui.view">
        <field name="name">club.session.form.features</field>
        <field name="model">club.session</field>
        <field name="inherit_id" ref="club_management_system_final.view_club_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_waitlist" type="object"
                        class="oe_stat_button" icon="fa-list">
                    <field name="waitlist_count" widget="statinfo" string="Waitlist"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='members']" position="after">
                <page string="Waitlist" name="waitlist">
                    <field name="waitlist_ids">
                        <list>
                            <field name="partner_id"/>
                            <field name="membership_id"/>
                            <field name="priority"/>
                            <field name="state"/>
                            <field name="offered_on"/>
                            <field name="joined_on"/>
                            <button name="action_mark_joined" string="Join" type="object"
                                    invisible="state not in ('waiting', 'offered')"/>
                            <button name="action_cancel" string="Cancel" type="object"
                                    invisible="state in ('cancelled', 'joined', 'expired')"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
