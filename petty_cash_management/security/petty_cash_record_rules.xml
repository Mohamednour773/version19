<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ─── Petty Cash Custody Record Rules ───────────────────────────── -->

        <!-- User: can only see own custodies -->
        <record id="rule_petty_cash_custody_user" model="ir.rule">
            <field name="name">Petty Cash: User sees own custodies</field>
            <field name="model_id" ref="petty_cash_management.model_hr_petty_cash"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash_management.group_petty_cash_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager: sees department custodies -->
        <record id="rule_petty_cash_custody_manager" model="ir.rule">
            <field name="name">Petty Cash: Manager sees department custodies</field>
            <field name="model_id" ref="petty_cash_management.model_hr_petty_cash"/>
            <field name="domain_force">['|',
                ('employee_id.user_id', '=', user.id),
                ('department_id.manager_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('petty_cash_management.group_petty_cash_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Accountant/Admin: see all custodies in their company -->
        <record id="rule_petty_cash_custody_accountant" model="ir.rule">
            <field name="name">Petty Cash: Accountant sees all company custodies</field>
            <field name="model_id" ref="petty_cash_management.model_hr_petty_cash"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('petty_cash_management.group_petty_cash_accountant'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ─── Fund Multi-company Rule ───────────────────────────────────── -->
        <record id="rule_petty_cash_fund_company" model="ir.rule">
            <field name="name">Petty Cash Fund: Company filter</field>
            <field name="model_id" ref="petty_cash_management.model_petty_cash_fund"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
