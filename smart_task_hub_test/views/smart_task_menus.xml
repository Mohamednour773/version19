<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu -->
    <menuitem id="menu_smart_task_root"
              name="🤖 Smart Task Hub"
              sequence="50"/>

    <!-- Main sub-menus -->
    <menuitem id="menu_smart_task_all"
              name="📋 All Tasks"
              parent="menu_smart_task_root"
              action="action_smart_task"
              sequence="10"/>

    <menuitem id="menu_smart_task_critical"
              name="🔴 Critical Tasks"
              parent="menu_smart_task_root"
              action="action_smart_task_critical"
              sequence="20"/>

    <menuitem id="menu_smart_task_kb"
              name="📚 Knowledge Base"
              parent="menu_smart_task_root"
              action="action_smart_knowledge_base"
              sequence="30"/>

    <!-- Reports sub-menu -->
    <menuitem id="menu_smart_task_reports"
              name="📊 Reports &amp; Analytics"
              parent="menu_smart_task_root"
              sequence="40"/>

    <menuitem id="menu_smart_task_dashboard"
              name="Dashboard"
              parent="menu_smart_task_reports"
              action="action_smart_task_dashboard"
              sequence="10"/>

    <menuitem id="menu_smart_ai_cost"
              name="💰 AI Cost Report"
              parent="menu_smart_task_reports"
              action="action_smart_ai_log"
              sequence="20"/>

    <!-- Settings -->
    <menuitem id="menu_smart_task_settings"
              name="⚙️ Settings"
              parent="menu_smart_task_root"
              action="action_smart_task_settings"
              sequence="99"
              groups="base.group_system"/>


    <!-- Excel Generator -->
    <menuitem id="menu_smart_excel_generator"
              name="Excel Generator"
              parent="menu_smart_task_root"
              action="action_smart_excel_generator"
              sequence="25"/>

</odoo>
