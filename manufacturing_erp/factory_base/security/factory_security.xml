<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_factory" model="ir.module.category">
            <field name="name">Factory Manufacturing | تصنيع المصنع</field>
            <field name="description">Project-based factory ERP | نظام إدارة المصنع القائم على المشاريع</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_factory_user" model="res.groups">
            <field name="name">Factory User | مستخدم المصنع</field>
            <field name="category_id" ref="module_category_factory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view and edit production records, mixes, and molds.</field>
        </record>

        <record id="group_factory_production_manager" model="res.groups">
            <field name="name">Production Manager | مدير الإنتاج</field>
            <field name="category_id" ref="module_category_factory"/>
            <field name="implied_ids" eval="[(4, ref('group_factory_user'))]"/>
            <field name="comment">Can manage production orders, mixes, and approve sectors.</field>
        </record>

        <record id="group_factory_manager" model="res.groups">
            <field name="name">Factory Manager | مدير المصنع</field>
            <field name="category_id" ref="module_category_factory"/>
            <field name="implied_ids" eval="[(4, ref('group_factory_production_manager')), (4, ref('account.group_account_manager'))]"/>
            <field name="comment">Full access including costing, pricing, and reports.</field>
        </record>

    </data>
</odoo>
