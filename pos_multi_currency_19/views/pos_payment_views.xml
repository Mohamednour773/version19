<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_view_form_multi_currency" model="ir.ui.view">
        <field name="name">pos.payment.form.multi.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="payment_currency_id" readonly="1"/>
                <field name="foreign_amount" readonly="1"/>
                <field name="exchange_rate" readonly="1"/>
                <field name="exchange_rate_date" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_view_list_multi_currency" model="ir.ui.view">
        <field name="name">pos.payment.list.multi.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="payment_currency_id" optional="show"/>
                <field name="foreign_amount" optional="show"/>
                <field name="exchange_rate" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_view_search_multi_currency" model="ir.ui.view">
        <field name="name">pos.payment.search.multi.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="payment_currency_id"/>
                <field name="foreign_amount"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_payment_method']" position="after">
                <filter
                    name="group_by_payment_currency"
                    string="Payment Currency"
                    domain="[]"
                    context="{'group_by':'payment_currency_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
