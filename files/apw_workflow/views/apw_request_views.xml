<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── List ──────────────────────────────────────────────────── -->
    <record id="view_apw_request_list" model="ir.ui.view">
        <field name="name">apw.request.list</field>
        <field name="model">apw.request</field>
        <field name="arch" type="xml">
            <list string="APW Approval Requests"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'"
                  decoration-warning="state == 'in_progress'"
                  decoration-info="state == 'pending'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="res_name" string="Document"/>
                <field name="config_id" string="Workflow"/>
                <field name="requester_id"/>
                <field name="current_stage_id" string="Current Stage"/>
                <field name="waiting_on"/>
                <field name="progress_percent" string="Progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"
                       decoration-warning="state == 'in_progress'"
                       decoration-info="state in ('pending','draft')"
                       decoration-secondary="state == 'cancelled'"/>
                <field name="date_submitted"/>
            </list>
        </field>
    </record>

    <!-- ─── Form ──────────────────────────────────────────────────── -->
    <record id="view_apw_request_form" model="ir.ui.view">
        <field name="name">apw.request.form</field>
        <field name="model">apw.request</field>
        <field name="arch" type="xml">
            <form string="APW Approval Request">
                <header>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-secondary"
                            invisible="state in ('approved','refused','cancelled')"
                            confirm="Cancel this approval request?"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object" invisible="state != 'cancelled'"/>
                    <button name="action_open_document" string="Open Document"
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,in_progress,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2 class="text-muted"><field name="res_name" readonly="1"/></h2>
                    </div>

                    <group>
                        <group string="Request Details">
                            <field name="config_id" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="date_submitted" readonly="1"/>
                            <field name="date_approved" readonly="1"
                                   invisible="not date_approved"/>
                            <field name="date_refused" readonly="1"
                                   invisible="not date_refused"/>
                        </group>
                        <group string="Current Status">
                            <field name="current_stage_id" readonly="1"/>
                            <field name="waiting_on" readonly="1"
                                   invisible="state not in ('pending','in_progress')"/>
                            <field name="progress_percent" readonly="1"
                                   widget="progressbar"/>
                            <field name="res_model" readonly="1" string="Model"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Approval Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list decoration-success="state == 'approved'"
                                      decoration-danger="state == 'refused'"
                                      decoration-info="state == 'pending'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="stage_sequence" string="#" width="40px"/>
                                    <field name="stage_name" string="Stage"/>
                                    <field name="approver_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'refused'"
                                           decoration-info="state == 'pending'"
                                           decoration-secondary="state == 'cancelled'"/>
                                    <field name="date_decided" string="Decision Date"/>
                                    <field name="note" string="Comment"/>
                                    <button name="action_approve" string="Approve"
                                            type="object" class="btn-success btn-sm"
                                            invisible="state != 'pending'" icon="fa-check"/>
                                    <button name="action_refuse" string="Refuse"
                                            type="object" class="btn-danger btn-sm"
                                            invisible="state != 'pending'" icon="fa-times"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Kanban ────────────────────────────────────────────────── -->
    <record id="view_apw_request_kanban" model="ir.ui.view">
        <field name="name">apw.request.kanban</field>
        <field name="model">apw.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="res_name"/>
                <field name="config_id"/>
                <field name="requester_id"/>
                <field name="current_stage_id"/>
                <field name="waiting_on"/>
                <field name="progress_percent"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="res_name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="name"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><b>Workflow:</b> <field name="config_id"/></div>
                                <div t-if="record.current_stage_id.value">
                                    <b>Stage:</b> <field name="current_stage_id"/>
                                </div>
                                <div t-if="record.waiting_on.value">
                                    <b>Waiting on:</b> <field name="waiting_on"/>
                                </div>
                                <div class="mt-2">
                                    <field name="progress_percent" widget="progressbar"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="requester_id" widget="many2one_avatar_user"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="date_submitted" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ─── Search ────────────────────────────────────────────────── -->
    <record id="view_apw_request_search" model="ir.ui.view">
        <field name="name">apw.request.search</field>
        <field name="model">apw.request</field>
        <field name="arch" type="xml">
            <search string="Search APW Requests">
                <field name="name"/>
                <field name="res_name"/>
                <field name="requester_id"/>
                <field name="config_id"/>
                <separator/>
                <filter name="my_approvals" string="My Pending Approvals"
                        domain="[('line_ids.approver_id','=',uid),
                                 ('line_ids.state','=','pending'),
                                 ('state','in',['pending','in_progress'])]"/>
                <filter name="in_progress" string="In Progress"
                        domain="[('state','=','in_progress')]"/>
                <filter name="pending" string="Pending"
                        domain="[('state','=','pending')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state','=','approved')]"/>
                <filter name="refused" string="Refused"
                        domain="[('state','=','refused')]"/>
                <separator/>
                <filter name="my_requests" string="My Requests"
                        domain="[('requester_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Workflow" name="grp_wf"
                            context="{'group_by':'config_id'}"/>
                    <filter string="State" name="grp_state"
                            context="{'group_by':'state'}"/>
                    <filter string="Requester" name="grp_req"
                            context="{'group_by':'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ─── Actions ───────────────────────────────────────────────── -->
    <record id="action_apw_request" model="ir.actions.act_window">
        <field name="name">APW Approval Requests</field>
        <field name="res_model">apw.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approval requests yet!</p>
        </field>
    </record>

    <record id="action_apw_my_pending" model="ir.actions.act_window">
        <field name="name">My Pending Requests</field>
        <field name="res_model">apw.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[
            ('requester_id','=',uid),
            ('state','in',['pending','in_progress'])
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending requests you submitted.</p>
        </field>
    </record>

</odoo>
