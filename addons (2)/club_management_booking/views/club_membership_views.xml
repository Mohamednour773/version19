<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Add a "Book Sessions" stat button to the membership form.
        Inherits the form view from club_management_system_final.
    -->
    <record id="view_club_membership_form_booking_button" model="ir.ui.view">
        <field name="name">club.membership.form.booking.button</field>
        <field name="model">club.membership</field>
        <field name="inherit_id" ref="club_management_system_final.view_club_membership_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_booking_wizard"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o"
                        groups="club_management_system_final.group_club_reception,club_management_system_final.group_club_manager,club_management_system_final.group_club_admin">
                    <field name="booked_session_count"
                           widget="statinfo"
                           string="Sessions Booked"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
