<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════
         MY SESSIONS TODAY — Trainer mobile view
         Filters to the logged-in trainer's sessions
         for today using record rules + context filter.
    ════════════════════════════════════ -->
    <record id="action_my_sessions_today" model="ir.actions.act_window">
        <field name="name">Today's Sessions</field>
        <field name="res_model">club.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('date', '=', context_today().strftime('%Y-%m-%d')),
            ('trainer_id.user_id', '=', uid)
        ]</field>
        <field name="context">{
            'search_default_confirmed': 1,
            'search_default_in_progress': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sessions today!</p>
            <p>Your scheduled sessions for today will appear here.</p>
        </field>
    </record>

    <!-- ════════════════════════════════════
         QUICK ATTENDANCE — compact list for mobile
         Shows attendance records the trainer can
         mark quickly in the field.
    ════════════════════════════════════ -->
    <record id="view_mobile_attendance_list" model="ir.ui.view">
        <field name="name">club.attendance.mobile.list</field>
        <field name="model">club.attendance</field>
        <field name="priority">8</field>
        <field name="arch" type="xml">
            <list string="Quick Attendance"
                  decoration-success="state == 'attended'"
                  decoration-danger="state == 'absent'"
                  decoration-warning="state == 'excused'"
                  editable="bottom">
                <field name="date" column_invisible="1"/>
                <field name="session_id"/>
                <field name="partner_id" string="Client"/>
                <field name="check_in"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'attended'"
                       decoration-danger="state == 'absent'"
                       decoration-warning="state == 'excused'"/>
                <button name="action_mark_attended" string="✓ Present"
                        type="object" class="btn-sm btn-success"
                        invisible="state == 'attended'"/>
                <button name="action_mark_absent" string="✗ Absent"
                        type="object" class="btn-sm btn-danger"
                        invisible="state == 'absent'"/>
            </list>
        </field>
    </record>

    <record id="action_my_quick_attendance" model="ir.actions.act_window">
        <field name="name">Mark Attendance</field>
        <field name="res_model">club.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mobile_attendance_list"/>
        <field name="domain">[
            ('date', '=', context_today().strftime('%Y-%m-%d')),
            ('trainer_id.user_id', '=', uid)
        ]</field>
        <field name="context">{'search_default_group_session': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No attendance records for today!</p>
            <p>Use "Take Attendance" on a session to generate records here.</p>
        </field>
    </record>

    <!-- ════════════════════════════════════
         MY SCHEDULE MENU ITEMS
         Added under the existing "My Schedule"
         trainer menu (menu_club_trainer_root).
    ════════════════════════════════════ -->
    <menuitem id="menu_my_sessions_today"
              name="Today's Sessions"
              parent="club_management_system_final.menu_club_trainer_root"
              action="club_management_system_final.action_my_sessions_today"
              sequence="5"
              groups="group_club_trainer"/>

    <menuitem id="menu_my_quick_attendance"
              name="Mark Attendance"
              parent="club_management_system_final.menu_club_trainer_root"
              action="club_management_system_final.action_my_quick_attendance"
              sequence="15"
              groups="group_club_trainer"/>

</odoo>
