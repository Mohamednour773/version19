<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default system parameters -->
    <record id="param_openai_model" model="ir.config_parameter">
        <field name="key">smart_task_hub_test.openai_model</field>
        <field name="value">gpt-4o</field>
    </record>
    <record id="param_claude_model" model="ir.config_parameter">
        <field name="key">smart_task_hub_test.claude_model</field>
        <field name="value">claude-opus-4-5-20251001</field>
    </record>
    <record id="param_auto_analyze" model="ir.config_parameter">
        <field name="key">smart_task_hub_test.auto_analyze</field>
        <field name="value">True</field>
    </record>
</odoo>
