<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_factory_production_list" model="ir.ui.view">
        <field name="name">factory.production.list</field>
        <field name="model">factory.production</field>
        <field name="arch" type="xml">
            <list string="Production Orders | أوامر الإنتاج"
                  decoration-info="state == 'planned'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date_planned"/>
                <field name="project_id"/>
                <field name="sector_id"/>
                <field name="product_id"/>
                <field name="quantity_planned" sum="Planned"/>
                <field name="quantity_produced" sum="Produced"/>
                <field name="quantity_waste" sum="Waste" optional="show"/>
                <field name="current_stage_id" optional="show"/>
                <field name="cost_per_unit" widget="monetary" optional="hide"/>
                <field name="cost_total" widget="monetary" sum="Total Cost"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_factory_production_form" model="ir.ui.view">
        <field name="name">factory.production.form</field>
        <field name="model">factory.production</field>
        <field name="arch" type="xml">
            <form string="Production Order | أمر الإنتاج">
                <header>
                    <button name="action_plan" string="Plan Stages | تخطيط المراحل"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Production | بدء الإنتاج"
                            type="object" class="btn-primary"
                            invisible="state != 'planned'"/>
                    <button name="action_done" string="Mark Done | إنهاء"
                            type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel | إلغاء"
                            type="object"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset" string="Reset | إعادة"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_consumption" type="object"
                                class="oe_stat_button" icon="fa-flask"
                                invisible="not consumption_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Consumption | الاستهلاك</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Project | المشروع">
                            <field name="project_id"/>
                            <field name="sector_id"/>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Planning | التخطيط">
                            <field name="date_planned"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_finished" readonly="1"/>
                            <field name="current_stage_id" readonly="1"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Quantities | الكميات">
                            <field name="quantity_planned"/>
                            <field name="quantity_produced" readonly="1"/>
                            <field name="quantity_waste" readonly="1"/>
                            <field name="quantity_remaining" readonly="1"/>
                        </group>
                        <group string="Recipe &amp; Molds | الخلطة والقوالب">
                            <field name="mix_id" options="{'no_create': True}"/>
                            <field name="mold_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Manufacturing Stages | مراحل التصنيع">
                            <field name="stage_line_ids">
                                <list editable="bottom"
                                      decoration-success="state == 'done'"
                                      decoration-warning="state == 'in_progress'">
                                    <field name="stage_id"/>
                                    <field name="stage_type" optional="hide"/>
                                    <field name="quantity_planned"/>
                                    <field name="quantity_done"/>
                                    <field name="quantity_waste"/>
                                    <field name="waste_percent" widget="percentage"/>
                                    <field name="labor_hours"/>
                                    <field name="labor_rate"/>
                                    <field name="labor_cost" sum="Labor Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="date_start"/>
                                    <field name="date_finished"/>
                                    <field name="duration_hours" optional="hide"/>
                                    <field name="quality_passed" optional="hide"/>
                                    <field name="state" widget="badge"/>
                                    <button name="action_start" string="Start" type="object"
                                            icon="fa-play"
                                            invisible="state != 'pending' and state != 'ready'"/>
                                    <button name="action_done" string="Done" type="object"
                                            icon="fa-check"
                                            invisible="state != 'in_progress'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cost Summary | ملخص التكلفة">
                            <group>
                                <group string="Cost Categories | فئات التكلفة">
                                    <field name="cost_materials" widget="monetary"/>
                                    <field name="cost_molds" widget="monetary"/>
                                    <field name="cost_labor" widget="monetary"/>
                                </group>
                                <group string="Totals | الإجماليات">
                                    <field name="cost_total" widget="monetary" class="oe_subtotal_footer_separator"/>
                                    <field name="cost_per_unit" widget="monetary"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes | ملاحظات">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_factory_production_kanban" model="ir.ui.view">
        <field name="name">factory.production.kanban</field>
        <field name="model">factory.production</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bolder fs-5">
                                <field name="name"/>
                            </div>
                            <div><field name="product_id"/></div>
                            <div class="text-muted">
                                <field name="sector_id"/>
                            </div>
                            <div class="mt-1">
                                <field name="quantity_produced"/> / <field name="quantity_planned"/>
                                <field name="uom_id"/>
                            </div>
                            <div class="mt-1">
                                <span class="badge text-bg-info">
                                    <field name="current_stage_id"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_factory_production" model="ir.actions.act_window">
        <field name="name">Production Orders | أوامر الإنتاج</field>
        <field name="res_model">factory.production</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
