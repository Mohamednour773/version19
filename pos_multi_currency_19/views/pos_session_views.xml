<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_session_view_form_multi_currency" model="ir.ui.view">
        <field name="name">pos.session.form.multi.currency</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cash_register_balance_end_real']" position="after">
                <field
                    name="multi_currency_payment_summary"
                    widget="json"
                    readonly="1"
                    invisible="not multi_currency_payment_summary"
                />
            </xpath>
        </field>
    </record>
</odoo>
