<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="petty_cash_management.Dashboard">
        <div class="o_petty_cash_dashboard" style="padding: 20px; background: #f8f9fa; min-height: 100vh; direction: rtl; font-family: Arial, sans-serif;">

            <!-- Loading -->
            <t t-if="state.isLoading">
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status"/>
                    <p class="mt-2">جاري تحميل البيانات...</p>
                </div>
            </t>

            <t t-else="">
                <!-- Title -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h2 style="color: #2c5282; border-bottom: 3px solid #2c5282; padding-bottom: 10px;">
                            🏦 لوحة تحكم البيتي كاش | Petty Cash Dashboard
                        </h2>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-4">
                    <!-- Total Balance -->
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #2c5282, #4a90d9); cursor: pointer;"
                            t-on-click="openFunds">
                            <div class="card-body text-white text-center">
                                <div style="font-size: 2rem;">💰</div>
                                <div style="font-size: 1.5rem; font-weight: bold;">
                                    <t t-esc="state.totalBalance.toLocaleString('ar-EG', {minimumFractionDigits: 2})"/>
                                </div>
                                <div>إجمالي رصيد الصناديق</div>
                            </div>
                        </div>
                    </div>

                    <!-- Active Funds -->
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm h-100" style="background: linear-gradient(135deg, #276749, #48bb78); cursor: pointer;"
                            t-on-click="openFunds">
                            <div class="card-body text-white text-center">
                                <div style="font-size: 2rem;">🏦</div>
                                <div style="font-size: 1.5rem; font-weight: bold;">
                                    <t t-esc="state.funds.length"/>
                                </div>
                                <div>الصناديق النشطة</div>
                            </div>
                        </div>
                    </div>

                    <!-- Pending Approvals -->
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm h-100"
                            t-attf-style="background: linear-gradient(135deg, #{state.pendingCount > 0 ? '#744210, #d69e2e' : '#4a5568, #718096'}); cursor: pointer;"
                            t-on-click="openPending">
                            <div class="card-body text-white text-center">
                                <div style="font-size: 2rem;">⏳</div>
                                <div style="font-size: 1.5rem; font-weight: bold;">
                                    <t t-esc="state.pendingCount"/>
                                </div>
                                <div>في انتظار الموافقة</div>
                            </div>
                        </div>
                    </div>

                    <!-- Overdue -->
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm h-100"
                            t-attf-style="background: linear-gradient(135deg, #{state.overdueCount > 0 ? '#742a2a, #fc8181' : '#4a5568, #718096'}); cursor: pointer;"
                            t-on-click="openOverdue">
                            <div class="card-body text-white text-center">
                                <div style="font-size: 2rem;">🚨</div>
                                <div style="font-size: 1.5rem; font-weight: bold;">
                                    <t t-esc="state.overdueCount"/>
                                </div>
                                <div>عهد متأخرة</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header" style="background: #2c5282; color: white;">
                                ⚡ إجراءات سريعة
                            </div>
                            <div class="card-body d-flex gap-2 flex-wrap">
                                <button class="btn btn-primary" t-on-click="openCustodies">
                                    📋 جميع العهد
                                </button>
                                <button class="btn btn-success" t-on-click="openSettlements">
                                    📄 التسويات
                                </button>
                                <button class="btn btn-warning" t-on-click="openPending">
                                    ⏳ الموافقات المعلقة
                                    <t t-if="state.pendingCount > 0">
                                        <span class="badge bg-danger ms-1"><t t-esc="state.pendingCount"/></span>
                                    </t>
                                </button>
                                <button class="btn btn-danger" t-on-click="openOverdue">
                                    🚨 العهد المتأخرة
                                    <t t-if="state.overdueCount > 0">
                                        <span class="badge bg-white text-danger ms-1"><t t-esc="state.overdueCount"/></span>
                                    </t>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Funds Table + Expenses -->
                <div class="row g-3">
                    <!-- Funds -->
                    <div class="col-md-7">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header" style="background: #2c5282; color: white;">
                                🏦 الصناديق النشطة
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>الصندوق</th>
                                            <th>أمين الصندوق</th>
                                            <th>الرصيد</th>
                                            <th>الحالة</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.funds" t-as="fund" t-key="fund.id">
                                            <tr>
                                                <td><strong><t t-esc="fund.name_ar || fund.name"/></strong></td>
                                                <td><t t-esc="fund.custodian_id ? fund.custodian_id[1] : ''"/></td>
                                                <td>
                                                    <span t-attf-style="color: #{fund.current_balance &lt; fund.min_balance ? '#dc3545' : '#28a745'}; font-weight: bold;">
                                                        <t t-esc="fund.current_balance.toLocaleString('ar-EG', {minimumFractionDigits: 2})"/>
                                                    </span>
                                                </td>
                                                <td>
                                                    <t t-if="fund.current_balance &lt; fund.min_balance">
                                                        <span class="badge bg-danger">رصيد منخفض</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-success">طبيعي</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="state.funds.length === 0">
                                            <tr>
                                                <td colspan="4" class="text-center text-muted">لا توجد صناديق نشطة</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Expenses by Category -->
                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header" style="background: #2c5282; color: white;">
                                📊 المصاريف حسب الفئة (آخر 30 يوم)
                            </div>
                            <div class="card-body">
                                <t t-if="state.expensesByCategory.length === 0">
                                    <p class="text-muted text-center">لا توجد مصاريف مسجلة</p>
                                </t>
                                <t t-else="">
                                    <t t-set="maxAmount" t-value="Math.max(...state.expensesByCategory.map(c => c.amount))"/>
                                    <t t-foreach="state.expensesByCategory" t-as="cat" t-key="cat.name">
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between mb-1">
                                                <small><t t-esc="cat.name"/></small>
                                                <small class="fw-bold"><t t-esc="cat.amount.toLocaleString('ar-EG', {minimumFractionDigits: 2})"/></small>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar bg-primary"
                                                    t-attf-style="width: #{maxAmount > 0 ? (cat.amount / maxAmount * 100).toFixed(0) : 0}%"/>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
