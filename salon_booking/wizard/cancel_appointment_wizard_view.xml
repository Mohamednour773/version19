<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salon_cancel_appointment_wizard_form" model="ir.ui.view">
        <field name="name">salon.cancel.appointment.wizard.form</field>
        <field name="model">salon.cancel.appointment.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Appointment">

                <div class="alert alert-warning d-flex align-items-center"
                     role="alert"
                     invisible="within_policy">
                    <i class="fa fa-exclamation-triangle me-2 fs-4"/>
                    <div>
                        <strong>Cancellation Policy Active</strong><br/>
                        This appointment is within the minimum notice period.
                        Cancellation may be restricted. Contact management if needed.
                    </div>
                </div>

                <group string="Appointment Details">
                    <field name="appointment_name"/>
                    <field name="appointment_start"/>
                    <field name="employee_name"/>
                </group>

                <group string="Cancellation">
                    <field name="cancellation_reason"
                           placeholder="Please enter a reason for this cancellation…"
                           required="1"/>
                    <field name="notify_customer"/>
                </group>

                <!-- Hidden field consumed by the alert above -->
                <field name="within_policy" invisible="1"/>

                <footer>
                    <button name="action_confirm_cancel"
                            string="Confirm Cancellation"
                            type="object"
                            class="btn-danger"/>
                    <button string="Go Back"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>
