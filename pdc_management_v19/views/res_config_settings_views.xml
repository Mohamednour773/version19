<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Inherit res.config.settings form — PDC section ────────────────── -->
    <record id="view_res_config_settings_pdc" model="ir.ui.view">
        <field name="name">res.config.settings.pdc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <h2>Post-Dated Checks (PDC)</h2>

                <!-- Due Date Alerts -->
                <div class="row mt16 o_settings_container" id="pdc_alerts">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Due Date Alerts</span>
                            <div class="text-muted">
                                Number of days before due date to trigger
                                each reminder level.
                            </div>
                            <div class="content-group mt8">
                                <div class="row">
                                    <label for="pdc_alert_days_first"
                                           class="col-lg-4 o_light_label">
                                        First (Urgent)
                                    </label>
                                    <field name="pdc_alert_days_first"
                                           class="col-lg-2"/>
                                    <span class="col-lg-2 text-muted">days</span>
                                </div>
                                <div class="row">
                                    <label for="pdc_alert_days_second"
                                           class="col-lg-4 o_light_label">
                                        Second
                                    </label>
                                    <field name="pdc_alert_days_second"
                                           class="col-lg-2"/>
                                    <span class="col-lg-2 text-muted">days</span>
                                </div>
                                <div class="row">
                                    <label for="pdc_alert_days_third"
                                           class="col-lg-4 o_light_label">
                                        Third (Early Warning)
                                    </label>
                                    <field name="pdc_alert_days_third"
                                           class="col-lg-2"/>
                                    <span class="col-lg-2 text-muted">days</span>
                                </div>
                                <div class="row">
                                    <label for="pdc_due_soon_days"
                                           class="col-lg-4 o_light_label">
                                        Due Soon Window
                                    </label>
                                    <field name="pdc_due_soon_days"
                                           class="col-lg-2"/>
                                    <span class="col-lg-2 text-muted">days</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Partner Blocking -->
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pdc_auto_block_partners"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pdc_auto_block_partners"/>
                            <div class="text-muted">
                                Automatically block partners who exceed the bounce
                                threshold.
                            </div>
                            <div class="content-group mt8"
                                 invisible="not pdc_auto_block_partners">
                                <div class="row">
                                    <label for="pdc_block_threshold"
                                           class="col-lg-6 o_light_label">
                                        Block after (bounces)
                                    </label>
                                    <field name="pdc_block_threshold"
                                           class="col-lg-2"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Printing & Display -->
                <div class="row mt16 o_settings_container" id="pdc_printing">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pdc_require_image"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pdc_require_image"/>
                            <div class="text-muted">
                                Make check image upload mandatory when registering
                                a received check.
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pdc_use_hijri"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pdc_use_hijri"/>
                            <div class="text-muted">
                                Show Hijri (Islamic) calendar dates alongside
                                Gregorian dates on check forms.
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pdc_default_layout_ar"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pdc_default_layout_ar"/>
                            <div class="text-muted">
                                Default to Arabic print layout when printing
                                checks.
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="pdc_company_city"
                                   string="Default City for Check Printing"/>
                            <div class="text-muted">
                                City printed in the place/date field on checks.
                            </div>
                            <field name="pdc_company_city"
                                   class="mt8"
                                   placeholder="e.g. Cairo"/>
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>

</odoo>
