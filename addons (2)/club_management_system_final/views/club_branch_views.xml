<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════
         TREE VIEW
    ════════════════════════════════════ -->
    <record id="view_club_branch_tree" model="ir.ui.view">
        <field name="name">club.branch.tree</field>
        <field name="model">club.branch</field>
        <field name="arch" type="xml">
            <list string="Branches" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="manager_id"/>
                <field name="pricelist_id"/>
                <field name="trainer_count" string="Trainers"/>
                <field name="facility_count" string="Facilities"/>
                <field name="membership_count" string="Members"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════
         FORM VIEW
    ════════════════════════════════════ -->
    <record id="view_club_branch_form" model="ir.ui.view">
        <field name="name">club.branch.form</field>
        <field name="model">club.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trainers" type="object"
                                class="oe_stat_button" icon="fa-user">
                            <field name="trainer_count" widget="statinfo" string="Trainers"/>
                        </button>
                        <button name="action_view_facilities" type="object"
                                class="oe_stat_button" icon="fa-building">
                            <field name="facility_count" widget="statinfo" string="Facilities"/>
                        </button>
                        <button name="action_view_classes" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="class_count" widget="statinfo" string="Classes"/>
                        </button>
                        <button name="action_view_memberships" type="object"
                                class="oe_stat_button" icon="fa-id-card">
                            <field name="membership_count" widget="statinfo" string="Members"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Branch Name"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Pricing">
                            <field name="pricelist_id"/>
                        </group>
                    </group>
                    <group string="Contact Information">
                        <group>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allowed Users" name="users">
                            <field name="user_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════
         SEARCH VIEW
    ════════════════════════════════════ -->
    <record id="view_club_branch_search" model="ir.ui.view">
        <field name="name">club.branch.search</field>
        <field name="model">club.branch</field>
        <field name="arch" type="xml">
            <search string="Branches">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="manager_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════
         ACTION
    ════════════════════════════════════ -->
    <record id="action_club_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">club.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_club_branch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first branch!
            </p>
            <p>Define branches for your sports club. Each branch has its own trainers, facilities and price list.</p>
        </field>
    </record>

</odoo>
