<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_apw_line_dashboard_list" model="ir.ui.view">
        <field name="name">apw.request.line.dashboard.list</field>
        <field name="model">apw.request.line</field>
        <field name="arch" type="xml">
            <list string="APW Pending Approvals"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'"
                  decoration-muted="state == 'cancelled'">
                <field name="request_id" string="Request"/>
                <field name="res_name" string="Document"/>
                <field name="config_id" string="Workflow"/>
                <field name="stage_name" string="Stage"/>
                <field name="stage_sequence" string="Seq" width="50px"/>
                <field name="approver_id" string="Approver"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"
                       decoration-secondary="state == 'cancelled'"/>
                <field name="date_decided" string="Decided On"/>
                <field name="note" string="Comment" optional="show"/>
                <button name="action_approve" string="Approve" type="object"
                        class="btn-success btn-sm"
                        invisible="state != 'pending'" icon="fa-check"/>
                <button name="action_refuse" string="Refuse" type="object"
                        class="btn-danger btn-sm"
                        invisible="state != 'pending'" icon="fa-times"/>
            </list>
        </field>
    </record>

    <record id="view_apw_line_dashboard_search" model="ir.ui.view">
        <field name="name">apw.request.line.dashboard.search</field>
        <field name="model">apw.request.line</field>
        <field name="arch" type="xml">
            <search string="Search Approval Lines">
                <field name="res_name"/>
                <field name="approver_id"/>
                <field name="config_id"/>
                <separator/>
                <filter name="my_pending" string="Assigned to Me"
                        domain="[('approver_id','=',uid),('state','=','pending')]"/>
                <filter name="all_pending" string="All Pending"
                        domain="[('state','=','pending')]"/>
                <filter name="state_approved" string="Approved"
                        domain="[('state','=','approved')]"/>
                <filter name="state_refused" string="Refused"
                        domain="[('state','=','refused')]"/>
                <group expand="0" string="Group By">
                    <filter string="Workflow" name="grp_wf"
                            context="{'group_by':'config_id'}"/>
                    <filter string="Stage" name="grp_stage"
                            context="{'group_by':'stage_name'}"/>
                    <filter string="Approver" name="grp_approver"
                            context="{'group_by':'approver_id'}"/>
                    <filter string="State" name="grp_state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_apw_dashboard" model="ir.actions.act_window">
        <field name="name">APW Pending Approvals</field>
        <field name="res_model">apw.request.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state','=','pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending approvals — great!</p>
        </field>
    </record>

    <record id="action_apw_my_queue" model="ir.actions.act_window">
        <field name="name">My APW Approval Queue</field>
        <field name="res_model">apw.request.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('approver_id','=',uid),('state','=','pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Your approval queue is empty!</p>
        </field>
    </record>

</odoo>
