<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_waitlist_tree" model="ir.ui.view">
        <field name="name">club.session.waitlist.tree</field>
        <field name="model">club.session.waitlist</field>
        <field name="arch" type="xml">
            <list string="Waitlist">
                <field name="session_id"/>
                <field name="partner_id"/>
                <field name="membership_id"/>
                <field name="priority"/>
                <field name="state" widget="badge"/>
                <field name="offered_on"/>
                <field name="joined_on"/>
            </list>
        </field>
    </record>

    <record id="view_club_waitlist_form" model="ir.ui.view">
        <field name="name">club.session.waitlist.form</field>
        <field name="model">club.session.waitlist</field>
        <field name="arch" type="xml">
            <form string="Waitlist Entry">
                <header>
                    <button name="action_offer_spot" string="Offer Spot" type="object"
                            invisible="state != 'waiting'"/>
                    <button name="action_mark_joined" string="Join Session" type="object"
                            invisible="state not in ('waiting', 'offered')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled', 'joined', 'expired')"/>
                    <button name="action_reset_waiting" string="Reset Waiting" type="object"
                            invisible="state == 'waiting'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="waiting,offered,joined,cancelled,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="membership_id"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="offered_on" readonly="1"/>
                            <field name="joined_on" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_club_waitlist_search" model="ir.ui.view">
        <field name="name">club.session.waitlist.search</field>
        <field name="model">club.session.waitlist</field>
        <field name="arch" type="xml">
            <search string="Waitlist">
                <field name="session_id"/>
                <field name="partner_id"/>
                <field name="membership_id"/>
                <filter string="Waiting" name="waiting" domain="[('state', '=', 'waiting')]"/>
                <filter string="Offered" name="offered" domain="[('state', '=', 'offered')]"/>
                <group>
                    <filter string="Session" name="group_session" context="{'group_by': 'session_id'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_club_waitlist" model="ir.actions.act_window">
        <field name="name">Waitlist</field>
        <field name="res_model">club.session.waitlist</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_club_waitlist_search"/>
    </record>
</odoo>
