<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ─── Daily Overdue Check ────────────────────────────────────────── -->
        <record id="ir_cron_check_overdue_custodies" model="ir.cron">
            <field name="name">Petty Cash: Daily Overdue Custody Check</field>
            <field name="model_id" ref="petty_cash_management.model_hr_petty_cash"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue_custodies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- ─── Fund Balance Check ─────────────────────────────────────────── -->
        <record id="ir_cron_check_fund_balance" model="ir.cron">
            <field name="name">Petty Cash: Daily Fund Balance Check</field>
            <field name="model_id" ref="petty_cash_management.model_petty_cash_fund_transfer"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_fund_balance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- ─── Monthly Reconciliation Reminder ───────────────────────────── -->
        <record id="ir_cron_monthly_reconciliation_reminder" model="ir.cron">
            <field name="name">Petty Cash: Monthly Reconciliation Reminder</field>
            <field name="model_id" ref="petty_cash_management.model_petty_cash_fund"/>
            <field name="state">code</field>
            <field name="code">
for fund in model.search([('state', '=', 'active')]):
    fund.message_post(
        body='🗓️ تذكير شهري: يرجى مراجعة وتسوية حسابات الصندوق | Monthly reconciliation reminder.',
        subtype_xmlid='mail.mt_note',
    )
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>

            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>

        <!-- ─── Sequences ─────────────────────────────────────────────────── -->
        <record id="seq_hr_petty_cash" model="ir.sequence">
            <field name="name">Employee Petty Cash Custody</field>
            <field name="code">hr.petty.cash</field>
            <field name="prefix">PCM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_petty_cash_settlement" model="ir.sequence">
            <field name="name">Petty Cash Settlement</field>
            <field name="code">petty.cash.settlement</field>
            <field name="prefix">PCS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_petty_cash_fund_transfer" model="ir.sequence">
            <field name="name">Petty Cash Fund Transfer</field>
            <field name="code">petty.cash.fund.transfer</field>
            <field name="prefix">PCT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
