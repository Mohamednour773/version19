<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_club_schedule_form" model="ir.ui.view">
        <field name="name">res.partner.club.schedule.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="club_management_system_final.view_partner_club_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_schedule_plan" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="not is_club_client">
                    <field name="upcoming_session_count" widget="statinfo" string="Plan"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='club_info']" position="inside">
                <separator string="Upcoming Sessions"/>
                <field name="upcoming_session_ids" readonly="1">
                    <list>
                        <field name="date"/>
                        <field name="class_id"/>
                        <field name="trainer_id"/>
                        <field name="time_start" widget="float_time"/>
                        <field name="time_end" widget="float_time"/>
                        <field name="state"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
