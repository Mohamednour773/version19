<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        noupdate="1" – prevent overwriting once the salon customises this
        template from Settings → WhatsApp → Templates.

        Placeholder mapping (WhatsApp Business API numbered variables):
            {{1}}  customer name          → partner_ids.name
            {{2}}  service / appt type   → appointment_type_id.name
            {{3}}  barber / stylist       → salon_employee_id.name
            {{4}}  appointment date       → start  (date portion)
            {{5}}  appointment time       → start  (time portion)

        After installation, go to WhatsApp ▸ Templates and map each
        {{n}} variable to its field on the calendar.event model.
    -->
    <record id="whatsapp_template_salon_booking_confirmation"
            model="whatsapp.template">
        <field name="name">Salon Booking Confirmation</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="status">approved</field>
        <field name="header_type">none</field>
        <field name="body">Hello {{1}}, your appointment for *{{2}}* with *{{3}}* is confirmed on *{{4}}* at *{{5}}*. We look forward to seeing you! Reply CANCEL to cancel your booking.</field>
    </record>

</odoo>
