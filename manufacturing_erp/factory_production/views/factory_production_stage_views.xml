<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_factory_production_stage_list" model="ir.ui.view">
        <field name="name">factory.production.stage.list</field>
        <field name="model">factory.production.stage</field>
        <field name="arch" type="xml">
            <list string="Production Stages | مراحل الإنتاج"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'in_progress'">
                <field name="production_id"/>
                <field name="stage_id"/>
                <field name="stage_type"/>
                <field name="quantity_done"/>
                <field name="quantity_waste"/>
                <field name="waste_percent" widget="percentage"/>
                <field name="labor_hours"/>
                <field name="labor_cost" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="date_start"/>
                <field name="date_finished"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_factory_production_stage" model="ir.actions.act_window">
        <field name="name">Production Stages | مراحل الإنتاج</field>
        <field name="res_model">factory.production.stage</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
