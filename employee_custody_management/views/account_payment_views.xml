<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_custody" model="ir.ui.view">
        <field name="name">account.payment.register.form.custody</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_custody_payment" invisible="1"/>
                <field name="custody_employee_id"
                       invisible="not is_custody_payment"
                       required="is_custody_payment"
                       options="{'no_create': True}"/>
                <field name="custody_request_id"
                       invisible="not is_custody_payment"
                       options="{'no_create': True}"/>
                <field name="custody_balance_before"
                       invisible="not is_custody_payment"
                       readonly="1"/>
                <field name="custody_balance_after"
                       invisible="not is_custody_payment"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_custody" model="ir.ui.view">
        <field name="name">account.payment.form.custody</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_type']" position="after">
                <field name="is_custody_payment" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="custody_employee_id"
                       invisible="not is_custody_payment"
                       required="is_custody_payment"
                       readonly="state != 'draft'"/>
                <field name="custody_request_id"
                       invisible="not is_custody_payment"
                       readonly="state != 'draft'"/>
                <field name="custody_balance_before"
                       invisible="not is_custody_payment"
                       readonly="1"/>
                <field name="custody_balance_after"
                       invisible="not is_custody_payment"
                       readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_list_custody" model="ir.ui.view">
        <field name="name">account.payment.list.custody</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_custody_payment" optional="hide"/>
                <field name="custody_employee_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
