<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_approval_notification" model="mail.template">
            <field name="name">Approval Request: Notification to Approver</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="subject">Action Required: Approval Request - {{ object.display_name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ ctx.get('approver') and ctx['approver'].email or '' }}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;">
    <div style="background-color: #875A7B; padding: 20px; text-align: center;">
        <h2 style="color: white; margin: 0;">Approval Required</h2>
    </div>
    <div style="padding: 30px;">
        <p>Dear <strong>{{ ctx.get('approver') and ctx['approver'].name or 'Approver' }}</strong>,</p>
        <p>An approval request is waiting for your action at stage <strong>{{ ctx.get('stage') and ctx['stage'].name or '' }}</strong>.</p>
        <table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
            <tr style="background-color: #f5f5f5;">
                <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Cycle</td>
                <td style="padding: 10px; border: 1px solid #ddd;">{{ object.cycle_id.name }}</td>
            </tr>
            <tr>
                <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Record</td>
                <td style="padding: 10px; border: 1px solid #ddd;">{{ object.res_name }}</td>
            </tr>
            <tr style="background-color: #f5f5f5;">
                <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Requested By</td>
                <td style="padding: 10px; border: 1px solid #ddd;">{{ object.requester_id.name }}</td>
            </tr>
            <tr>
                <td style="padding: 10px; border: 1px solid #ddd; font-weight: bold;">Notes</td>
                <td style="padding: 10px; border: 1px solid #ddd;">{{ object.notes or 'N/A' }}</td>
            </tr>
        </table>
        <div style="text-align: center; margin-top: 30px;">
            <a href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=approval.request&amp;view_type=form"
               style="background-color: #875A7B; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-size: 16px;">
                Review Request
            </a>
        </div>
    </div>
    <div style="background-color: #f5f5f5; padding: 15px; text-align: center; font-size: 12px; color: #888;">
        This is an automated message from {{ object.company_id.name }}.
    </div>
</div>
            </field>
        </record>
    </data>
</odoo>
