<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_view_form_airport_currency" model="ir.ui.view">
        <field name="name">pos.payment.form.airport.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="airport_currency_id" readonly="1"/>
                <field name="airport_amount" readonly="1"/>
                <field name="airport_exchange_rate" readonly="1"/>
                <field name="airport_exchange_rate_date" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_view_list_airport_currency" model="ir.ui.view">
        <field name="name">pos.payment.list.airport.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="airport_currency_id" optional="show"/>
                <field name="airport_amount" optional="show"/>
                <field name="airport_exchange_rate" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_view_search_airport_currency" model="ir.ui.view">
        <field name="name">pos.payment.search.airport.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="airport_currency_id"/>
                <field name="airport_amount"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_payment_method']" position="after">
                <filter
                    name="group_by_airport_currency"
                    string="Tender Currency"
                    domain="[]"
                    context="{'group_by':'airport_currency_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
