<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════
         TREE VIEW
    ════════════════════════════════════ -->
    <record id="view_club_class_tree" model="ir.ui.view">
        <field name="name">club.class.tree</field>
        <field name="model">club.class</field>
        <field name="arch" type="xml">
            <list string="Classes"
                  decoration-success="state == 'confirmed'"
                  decoration-muted="state in ('done', 'cancelled')"
                  decoration-warning="not has_valid_package">
                <field name="code"/>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="trainer_id"/>
                <field name="class_type"/>
                <field name="specialization"/>
                <field name="facility_id" optional="show"/>
                <field name="max_capacity"/>
                <field name="enrolled_count" string="Enrolled"/>
                <field name="time_start" widget="float_time"/>
                <field name="time_end" widget="float_time"/>
                <field name="has_valid_package" column_invisible="1"/>
                <field name="session_count" string="Sessions"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state in ('done', 'cancelled')"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════
         FORM VIEW
    ════════════════════════════════════ -->
    <record id="view_club_class_form" model="ir.ui.view">
        <field name="name">club.class.form</field>
        <field name="model">club.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_generate_sessions" string="Generate Sessions" type="object"
                            invisible="state != 'confirmed'" class="btn-success"/>
                    <button name="action_done" string="Mark Done" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"
                            confirm="Cancel this class?"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('cancelled',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <!-- Fields required by modifiers but not displayed directly -->
                    <field name="has_valid_package" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        <button type="object" name="action_view_sessions"
                                class="oe_stat_button" icon="fa-users">
                            <field name="enrolled_count" widget="statinfo" string="Enrolled"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="has_valid_package">
                        <i class="fa fa-warning"/> This class is not linked to any package. It will not be visible to clients until a package is assigned.
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Class Name"/></h1>
                        <div class="text-muted"><field name="code"/></div>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="branch_id"/>
                            <field name="trainer_id"
                                   domain="[('branch_id', '=', branch_id)]"/>
                            <field name="class_type"/>
                            <field name="specialization"/>
                            <field name="facility_id"
                                   domain="[('branch_id', '=', branch_id)]"/>
                            <field name="max_capacity"/>
                            <field name="available_spots" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Schedule">
                            <field name="schedule_type"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="duration" readonly="1" widget="float_time"/>
                            <field name="is_recurring"/>
                            <field name="recurrence_end_date" invisible="not is_recurring"/>
                        </group>
                    </group>
                    <!-- Weekly day checkboxes -->
                    <group string="Recurring Days" invisible="not is_recurring">
                        <div class="o_row">
                            <field name="day_mon"/>
                            <label for="day_mon" string="Mon"/>
                            <field name="day_tue"/>
                            <label for="day_tue" string="Tue"/>
                            <field name="day_wed"/>
                            <label for="day_wed" string="Wed"/>
                            <field name="day_thu"/>
                            <label for="day_thu" string="Thu"/>
                            <field name="day_fri"/>
                            <label for="day_fri" string="Fri"/>
                            <field name="day_sat"/>
                            <label for="day_sat" string="Sat"/>
                            <field name="day_sun"/>
                            <label for="day_sun" string="Sun"/>
                        </div>
                    </group>
                    <notebook>
                        <page string="Linked Packages" name="packages">
                            <field name="package_ids"
                                   domain="[('branch_id', '=', branch_id)]">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="package_type"/>
                                    <field name="total_sessions"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sessions" name="sessions">
                            <field name="session_ids">
                                <list decoration-success="state == 'done'"
                                      decoration-info="state == 'confirmed'"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="date"/>
                                    <field name="time_start" widget="float_time"/>
                                    <field name="time_end" widget="float_time"/>
                                    <field name="trainer_id"/>
                                    <field name="enrolled_count"/>
                                    <field name="attended_count"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════
         SEARCH VIEW
    ════════════════════════════════════ -->
    <record id="view_club_class_search" model="ir.ui.view">
        <field name="name">club.class.search</field>
        <field name="model">club.class</field>
        <field name="arch" type="xml">
            <search string="Classes">
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="trainer_id"/>
                <separator/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="No Package Linked" name="no_package"
                        domain="[('has_valid_package', '=', False)]"/>
                <separator/>
                <filter string="Group Classes" name="group_class"
                        domain="[('class_type', '=', 'group')]"/>
                <filter string="Private Sessions" name="private_class"
                        domain="[('class_type', '=', 'private')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Trainer" name="group_trainer" context="{'group_by': 'trainer_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'class_type'}"/>
                    <filter string="Sport" name="group_sport" context="{'group_by': 'specialization'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════
         ACTION
    ════════════════════════════════════ -->
    <record id="action_club_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">club.class</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_club_class_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first class!</p>
            <p>Classes must be linked to packages before they appear to clients.</p>
        </field>
    </record>

</odoo>
