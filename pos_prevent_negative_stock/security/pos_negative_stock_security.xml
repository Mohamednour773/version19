<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_pos_negative_stock_override" model="res.groups">
        <field name="name">POS Negative Stock Override</field>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>

    <!-- Record rule: override log scoped per company -->
    <record id="pos_order_line_override_comp_rule" model="ir.rule">
        <field name="name">POS Order Line Override: Multi-Company</field>
        <field name="model_id" ref="point_of_sale.model_pos_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

</odoo>
