<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====================================================================
         Approval Log - List View
    ==================================================================== -->
    <record id="view_approval_log_list" model="ir.ui.view">
        <field name="name">univ.approval.log.list</field>
        <field name="model">univ.approval.log</field>
        <field name="arch" type="xml">
            <list string="Approval Log"
                  decoration-success="action == 'approve'"
                  decoration-danger="action == 'reject'"
                  decoration-muted="action == 'cancel'"
                  create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="request_id"/>
                <field name="stage_id"/>
                <field name="approver_id"/>
                <field name="action_label" string="Action"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <!-- ====================================================================
         Approval Log - Form View (read-only)
    ==================================================================== -->
    <record id="view_approval_log_form" model="ir.ui.view">
        <field name="name">univ.approval.log.form</field>
        <field name="model">univ.approval.log</field>
        <field name="arch" type="xml">
            <form string="Approval Log Entry" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Details">
                            <field name="request_id"/>
                            <field name="stage_id"/>
                            <field name="approver_id"/>
                            <field name="action_label" string="Action"/>
                            <field name="date"/>
                        </group>
                        <group string="Comment">
                            <field name="comment" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_approval_log" model="ir.actions.act_window">
        <field name="name">Approval History</field>
        <field name="res_model">univ.approval.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
