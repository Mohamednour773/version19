<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Extend calendar.event FORM view with salon fields
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_salon_appointment_form" model="ir.ui.view">
        <field name="name">calendar.event.salon.form</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="appointment.calendar_event_view_form"/>
        <field name="arch" type="xml">

            <!-- Alert banner at the very top of the sheet -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info d-flex align-items-center"
                     role="alert"
                     invisible="not salon_channel">
                    <i class="fa fa-scissors me-2 fs-5"/>
                    <span>
                        Salon appointment booked via
                        <strong>
                            <span invisible="salon_channel != 'pos'">Point of Sale</span>
                            <span invisible="salon_channel != 'website'">Website</span>
                            <span invisible="salon_channel not in (False, 'backend')">Back-Office</span>
                        </strong>
                    </span>
                    <span class="ms-auto">
                        <span class="badge bg-success"
                              invisible="salon_status != 'confirmed'">Confirmed</span>
                        <span class="badge bg-secondary"
                              invisible="salon_status != 'draft'">Pending</span>
                        <span class="badge bg-danger"
                              invisible="salon_status != 'cancelled'">Cancelled</span>
                        <span class="badge bg-warning text-dark"
                              invisible="salon_status != 'no_show'">No-Show</span>
                    </span>
                </div>
            </xpath>

            <!-- Inject salon groups after the first standard group -->
            <xpath expr="//sheet//group[1]" position="after">
                <group string="Salon Details" name="salon_details">
                    <field name="salon_employee_id"/>
                    <field name="salon_channel" readonly="1"/>
                    <field name="salon_status"/>
                    <field name="salon_duration_minutes" readonly="1"/>
                    <field name="salon_whatsapp_sent" readonly="1"/>
                </group>
                <group string="POS Link" name="salon_pos_link"
                       invisible="salon_channel != 'pos'">
                    <field name="salon_pos_order_line_id" readonly="1"/>
                </group>
                <group string="Cancellation" name="salon_cancellation"
                       invisible="salon_status != 'cancelled'">
                    <field name="salon_cancellation_reason" readonly="1"/>
                </group>
            </xpath>

            <!-- Cancel button in the action buttons area -->
            <xpath expr="//header" position="inside">
                <button name="action_salon_cancel"
                        string="Cancel Appointment"
                        type="object"
                        class="btn-danger"
                        invisible="salon_status in ('cancelled','no_show')"/>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Salon Appointments – dedicated LIST view
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_salon_appointment_list" model="ir.ui.view">
        <field name="name">calendar.event.salon.list</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list string="Salon Appointments"
                  decoration-success="salon_status == 'confirmed'"
                  decoration-danger="salon_status == 'cancelled'"
                  decoration-warning="salon_status == 'no_show'"
                  decoration-muted="salon_status == 'draft'">
                <field name="name"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="salon_employee_id"/>
                <field name="appointment_type_id"/>
                <field name="salon_channel"
                       widget="badge"
                       decoration-info="salon_channel == 'website'"
                       decoration-primary="salon_channel == 'pos'"
                       decoration-muted="salon_channel == 'backend'"/>
                <field name="salon_status"
                       widget="badge"
                       decoration-success="salon_status == 'confirmed'"
                       decoration-danger="salon_status == 'cancelled'"
                       decoration-warning="salon_status == 'no_show'"
                       decoration-muted="salon_status == 'draft'"/>
                <field name="salon_whatsapp_sent" string="WA"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <button name="action_salon_cancel"
                        string="Cancel"
                        type="object"
                        icon="fa-times"
                        invisible="salon_status in ('cancelled','no_show')"
                        class="btn-danger"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Salon Appointments – KANBAN view
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_salon_appointment_kanban" model="ir.ui.view">
        <field name="name">calendar.event.salon.kanban</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <kanban default_group_by="salon_status"
                    class="o_salon_kanban"
                    quick_create="false">
                <field name="name"/>
                <field name="start"/>
                <field name="salon_employee_id"/>
                <field name="salon_status"/>
                <field name="salon_channel"/>
                <field name="appointment_type_id"/>
                <field name="partner_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between mb-1">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span t-if="record.salon_channel.raw_value == 'pos'"
                                      class="badge bg-primary">POS</span>
                                <span t-if="record.salon_channel.raw_value == 'website'"
                                      class="badge bg-info">Web</span>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-calendar me-1"/>
                                <field name="start" widget="datetime"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-user me-1"/>
                                <field name="salon_employee_id"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-tag me-1"/>
                                <field name="appointment_type_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Extend appointment.type FORM with salon tab
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_appointment_type_salon_form" model="ir.ui.view">
        <field name="name">appointment.type.salon.form</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Salon Settings" name="salon_settings">
                    <group>
                        <field name="is_salon_service"/>
                        <field name="salon_product_id"
                               invisible="not is_salon_service"/>
                        <field name="salon_color"
                               invisible="not is_salon_service"/>
                        <field name="salon_whatsapp_confirmation_template_name"
                               invisible="not is_salon_service"/>
                        <field name="salon_whatsapp_language_code"
                               invisible="not is_salon_service"/>
                    </group>
                    <group string="Barbers / Stylists"
                           invisible="not is_salon_service">
                        <field name="salon_employee_ids"
                               widget="many2many_tags"
                               nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         SEARCH view for salon appointments
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_salon_appointment_search" model="ir.ui.view">
        <field name="name">calendar.event.salon.search</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <search string="Search Salon Appointments">
                <field name="name"/>
                <field name="salon_employee_id"/>
                <field name="appointment_type_id"/>
                <field name="partner_ids"/>

                <filter string="Today" name="today"
                        domain="[('start','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                  ('start','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                <filter string="Confirmed" name="confirmed"
                        domain="[('salon_status','=','confirmed')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('salon_status','=','cancelled')]"/>
                <separator/>
                <filter string="Via POS" name="filter_pos"
                        domain="[('salon_channel','=','pos')]"/>
                <filter string="Via Website" name="filter_website"
                        domain="[('salon_channel','=','website')]"/>
                <separator/>
                <filter string="WhatsApp Not Sent" name="wa_pending"
                        domain="[('salon_whatsapp_sent','=',False),
                                  ('salon_status','=','confirmed')]"/>

                <group>
                    <filter string="Barber" name="group_barber"
                            context="{'group_by': 'salon_employee_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'salon_status'}"/>
                    <filter string="Channel" name="group_channel"
                            context="{'group_by': 'salon_channel'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Window action + menu
    ══════════════════════════════════════════════════════════════════ -->
    <record id="action_salon_appointments" model="ir.actions.act_window">
        <field name="name">Salon Appointments</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[('appointment_type_id.is_salon_service','=',True)]</field>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No salon appointments yet
            </p>
            <p>
                Appointments appear here once customers book online
                or staff book via the Point of Sale.
            </p>
        </field>
    </record>

    <record id="action_salon_appointment_types" model="ir.actions.act_window">
        <field name="name">Salon Services</field>
        <field name="res_model">appointment.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_salon_service','=',True)]</field>
        <field name="context">{'default_is_salon_service': True}</field>
    </record>

    <!-- Top-level menu -->
    <menuitem id="menu_salon_booking_root"
              name="Salon"
              sequence="80"/>

    <menuitem id="menu_salon_appointments"
              name="Appointments"
              parent="menu_salon_booking_root"
              action="action_salon_appointments"
              sequence="10"/>

    <menuitem id="menu_salon_appointment_types"
              name="Services"
              parent="menu_salon_booking_root"
              action="action_salon_appointment_types"
              sequence="20"/>

    <menuitem id="menu_salon_config"
              name="Configuration"
              parent="menu_salon_booking_root"
              sequence="90"/>

    <menuitem id="menu_salon_settings"
              name="Settings"
              parent="menu_salon_config"
              action="base_setup.action_general_configuration"
              sequence="10"/>

</odoo>
