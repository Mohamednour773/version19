<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_employee_custody" model="ir.module.category">
        <field name="name">Employee Custody</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_employee_custody" model="res.groups.privilege">
        <field name="name">Employee Custody</field>
        <field name="category_id" ref="module_category_employee_custody"/>
        <field name="sequence">35</field>
    </record>

    <record id="group_custody_user" model="res.groups">
        <field name="name">Custody User</field>
        <field name="privilege_id" ref="res_groups_privilege_employee_custody"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_custody_manager" model="res.groups">
        <field name="name">Custody Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_employee_custody"/>
        <field name="implied_ids" eval="[(4, ref('group_custody_user'))]"/>
    </record>

    <record id="group_custody_approver" model="res.groups">
        <field name="name">Custody Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_employee_custody"/>
        <field name="implied_ids" eval="[(4, ref('group_custody_manager'))]"/>
    </record>

    <record id="group_custody_admin" model="res.groups">
        <field name="name">Custody Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_employee_custody"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_manager')), (4, ref('group_custody_approver'))]"/>
    </record>

    <record id="rule_custody_category_company" model="ir.rule">
        <field name="name">Custody categories by company</field>
        <field name="model_id" ref="model_custody_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_custody_request_user" model="ir.rule">
        <field name="name">Users see own custody requests</field>
        <field name="model_id" ref="model_custody_request"/>
        <field name="groups" eval="[(4, ref('group_custody_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_custody_request_manager" model="ir.rule">
        <field name="name">Managers see company custody requests</field>
        <field name="model_id" ref="model_custody_request"/>
        <field name="groups" eval="[(4, ref('group_custody_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_custody_settlement_user" model="ir.rule">
        <field name="name">Users see own custody settlements</field>
        <field name="model_id" ref="model_custody_settlement"/>
        <field name="groups" eval="[(4, ref('group_custody_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('request_id.user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_custody_settlement_manager" model="ir.rule">
        <field name="name">Managers see company custody settlements</field>
        <field name="model_id" ref="model_custody_settlement"/>
        <field name="groups" eval="[(4, ref('group_custody_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_custody_settlement_line_company" model="ir.rule">
        <field name="name">Settlement lines by company</field>
        <field name="model_id" ref="model_custody_settlement_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
