<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_apw_config_list" model="ir.ui.view">
        <field name="name">apw.config.list</field>
        <field name="model">apw.config</field>
        <field name="arch" type="xml">
            <list string="APW Workflow Configurations" decoration-muted="not active">
                <field name="name"/>
                <field name="model_id"/>
                <field name="stage_count" string="Stages"/>
                <field name="pending_count" string="Pending"/>
                <field name="request_count" string="Requests"/>
                <field name="confirm_method" string="Confirm Action"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_apw_config_form" model="ir.ui.view">
        <field name="name">apw.config.form</field>
        <field name="model">apw.config</field>
        <field name="arch" type="xml">
            <form string="APW Workflow Configuration">
                <header>
                    <button name="action_inject_view"
                            string="Inject Approval Button into Form"
                            type="object"
                            class="btn-primary"
                            invisible="not model_id or injected_view_id != False"/>
                    <button name="action_inject_view"
                            string="Re-inject Button"
                            type="object"
                            class="btn-secondary"
                            invisible="not model_id or not injected_view_id"/>
                    <button name="action_remove_injection"
                            string="Remove Button from Form"
                            type="object"
                            invisible="not injected_view_id"
                            confirm="Remove the approval button from the target model's form view?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-check-circle">
                            <div class="o_stat_info">
                                <field name="pending_count" class="o_stat_value"/>
                                <span class="o_stat_text">Pending</span>
                            </div>
                        </button>
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info">
                                <field name="request_count" class="o_stat_value"/>
                                <span class="o_stat_text">Requests</span>
                            </div>
                        </button>
                        <button name="action_view_stages" type="object"
                                class="oe_stat_button" icon="fa-sitemap">
                            <div class="o_stat_info">
                                <field name="stage_count" class="o_stat_value"/>
                                <span class="o_stat_text">Stages</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Workflow Name..."/>
                        </h1>
                        <h2>
                            <field name="model_id" placeholder="Select target model..."
                                   options="{'no_create': True, 'no_open': True}"/>
                        </h2>
                    </div>

                    <div class="alert alert-success" invisible="not injected_view_id">
                        ✅ Approval button is injected into the target model's form view.
                        Users will see a "Request Approval" button and live status badge directly on the document.
                    </div>
                    <div class="alert alert-warning" invisible="not model_id or injected_view_id != False">
                        ⚠️ Click "Inject Approval Button into Form" to automatically add the approval button
                        and status badge to the target model's form view. No code changes required.
                    </div>

                    <group>
                        <group string="General">
                            <field name="model_name" readonly="1"/>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                        <group string="Actions After Decision">
                            <field name="confirm_method"
                                   placeholder="e.g. action_confirm"/>
                            <field name="cancel_method"
                                   placeholder="e.g. action_cancel"/>
                        </group>
                    </group>
                    <group>
                        <group string="Email Notifications">
                            <field name="notify_requester"/>
                            <field name="notify_next_approver"/>
                        </group>
                        <group string="Injected View">
                            <field name="injected_view_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Approval Stages" name="stages">
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="approver_user_id"
                                           invisible="approver_type != 'user'"/>
                                    <field name="approver_group_id"
                                           invisible="approver_type != 'group'"/>
                                    <field name="approver_field_id"
                                           invisible="approver_type != 'dynamic'"/>
                                    <field name="approver_display" readonly="1"
                                           string="Resolved As"/>
                                    <field name="allow_self_approval"/>
                                    <field name="auto_approve_if_missing"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_apw_config" model="ir.actions.act_window">
        <field name="name">Workflow Configurations</field>
        <field name="res_model">apw.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first APW workflow configuration!
            </p>
            <p>
                Select a model, add approval stages, then click
                "Inject Approval Button" to add the approve/refuse controls
                directly to that model's form view.
            </p>
        </field>
    </record>

</odoo>
