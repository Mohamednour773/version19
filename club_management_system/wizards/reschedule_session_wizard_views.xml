<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reschedule_session_wizard_form" model="ir.ui.view">
        <field name="name">club.reschedule.session.wizard.form</field>
        <field name="model">club.reschedule.session.wizard</field>
        <field name="arch" type="xml">
            <form string="Reschedule Session">
                <sheet>
                    <field name="has_trainer_conflict" invisible="1"/>
                    <field name="has_facility_conflict" invisible="1"/>
                    <!-- Conflict warning banner -->
                    <div class="alert alert-danger" role="alert"
                         invisible="not has_trainer_conflict and not has_facility_conflict">
                        <strong>⚠️ Scheduling Conflict Detected:</strong>
                        <field name="conflict_message" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="has_trainer_conflict or has_facility_conflict">
                        ✅ No conflicts detected for the selected time slot.
                    </div>
                    <group string="Current Schedule (Read-Only)">
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="current_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="current_start" widget="float_time" readonly="1"/>
                            <field name="current_end" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="New Schedule">
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" placeholder="Optional: reason for rescheduling..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reschedule" string="Reschedule" type="object"
                            class="btn-primary" data-hotkey="s"
                            invisible="has_trainer_conflict or has_facility_conflict"/>
                    <button name="action_reschedule_force" string="Force Reschedule (Override Conflicts)"
                            type="object" class="btn-warning"
                            invisible="not has_trainer_conflict and not has_facility_conflict"
                            confirm="Are you sure you want to reschedule despite the conflicts?"
                            groups="club_management_system.group_club_admin"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
