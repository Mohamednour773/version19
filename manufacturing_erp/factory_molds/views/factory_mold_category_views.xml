<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_factory_mold_category_list" model="ir.ui.view">
        <field name="name">factory.mold.category.list</field>
        <field name="model">factory.mold.category</field>
        <field name="arch" type="xml">
            <list string="Mold Categories | فئات القوالب">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="default_expected_uses"/>
            </list>
        </field>
    </record>

    <record id="view_factory_mold_category_form" model="ir.ui.view">
        <field name="name">factory.mold.category.form</field>
        <field name="model">factory.mold.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="default_expected_uses"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Description | الوصف"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_factory_mold_category" model="ir.actions.act_window">
        <field name="name">Mold Categories | فئات القوالب</field>
        <field name="res_model">factory.mold.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
