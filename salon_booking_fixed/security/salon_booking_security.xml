<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         Module category  (ir.module.category – exists in all editions)
    ══════════════════════════════════════════════════════════════════ -->
    <record id="module_category_salon_booking" model="ir.module.category">
        <field name="name">Salon Booking</field>
        <field name="description">
            Manage access rights for the Salon Booking module.
        </field>
        <field name="sequence">80</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Security groups
         category_id links to ir.module.category (works on both
         Community and Enterprise – privilege_id is Enterprise-only
         and intentionally omitted for cross-edition compatibility).
    ══════════════════════════════════════════════════════════════════ -->

    <!-- Salon User: view + create appointments; cannot edit configuration -->
    <record id="group_salon_user" model="res.groups">
        <field name="name">Salon User</field>
        <field name="category_id" ref="module_category_salon_booking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Salon Manager: full access including configuration and deletion -->
    <record id="group_salon_manager" model="res.groups">
        <field name="name">Salon Manager</field>
        <field name="category_id" ref="module_category_salon_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_salon_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')),
                                      (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Record rules – calendar.event (salon appointments)
    ══════════════════════════════════════════════════════════════════ -->

    <!-- Salon users can read/write ALL salon appointments -->
    <record id="rule_salon_appointment_user" model="ir.rule">
        <field name="name">Salon User: read/write all salon appointments</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="groups" eval="[(4, ref('group_salon_user'))]"/>
        <field name="domain_force">
            [('appointment_type_id.is_salon_service', '=', True)]
        </field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Salon managers have full (including delete) access -->
    <record id="rule_salon_appointment_manager" model="ir.rule">
        <field name="name">Salon Manager: full appointment access</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="groups" eval="[(4, ref('group_salon_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
