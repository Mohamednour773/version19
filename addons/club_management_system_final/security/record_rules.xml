<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════════════════
             BRANCH ISOLATION RULES
             Admin  → no restriction (sees all)
             Manager / Reception → only their branch (via branch.user_ids)
             Trainer → only sessions/attendance where they are the trainer
        ═══════════════════════════════════════════════════════════ -->

        <!-- ─── BRANCH ─── -->
        <record id="rule_branch_manager" model="ir.rule">
            <field name="name">Branch: Manager sees own branch only</field>
            <field name="model_id" ref="model_club_branch"/>
            <field name="groups" eval="[(4, ref('club_management_system_final.group_club_manager'))]"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_branch_reception" model="ir.rule">
