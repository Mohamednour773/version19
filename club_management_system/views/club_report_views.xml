<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════
         SESSION UTILIZATION REPORT
    ══════════════════════════════════════════════════ -->

    <record id="view_report_session_util_tree" model="ir.ui.view">
        <field name="name">club.report.session.utilization.tree</field>
        <field name="model">club.report.session.utilization</field>
        <field name="arch" type="xml">
            <list string="Session Utilization" create="false" delete="false" edit="false">
                <field name="date"/>
                <field name="branch_id"/>
                <field name="trainer_id"/>
                <field name="class_id"/>
                <field name="class_type"/>
                <field name="specialization"/>
                <field name="max_capacity"/>
                <field name="enrolled_count"/>
                <field name="attended_count"/>
                <field name="absent_count"/>
                <field name="utilization_pct" widget="progressbar"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_report_session_util_pivot" model="ir.ui.view">
        <field name="name">club.report.session.utilization.pivot</field>
        <field name="model">club.report.session.utilization</field>
        <field name="arch" type="xml">
            <pivot string="Session Utilization" disable_linking="True">
                <field name="branch_id" type="row"/>
                <field name="trainer_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="attended_count" type="measure"/>
                <field name="enrolled_count" type="measure"/>
                <field name="utilization_pct" type="measure"/>
                <field name="max_capacity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_report_session_util_graph" model="ir.ui.view">
        <field name="name">club.report.session.utilization.graph</field>
        <field name="model">club.report.session.utilization</field>
        <field name="arch" type="xml">
            <graph string="Session Utilization" type="bar" stacked="True">
                <field name="branch_id" type="row"/>
                <field name="attended_count" type="measure"/>
                <field name="enrolled_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_report_session_util_search" model="ir.ui.view">
        <field name="name">club.report.session.utilization.search</field>
        <field name="model">club.report.session.utilization</field>
        <field name="arch" type="xml">
            <search string="Session Utilization">
                <field name="branch_id"/>
                <field name="trainer_id"/>
                <field name="class_id"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Trainer" name="group_trainer" context="{'group_by': 'trainer_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Sport" name="group_sport" context="{'group_by': 'specialization'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_session_utilization" model="ir.actions.act_window">
        <field name="name">Session Utilization</field>
        <field name="res_model">club.report.session.utilization</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_session_util_search"/>
        <field name="context">{'search_default_done': 1}</field>
    </record>

    <!-- ══════════════════════════════════════════════════
         TRAINER REVENUE REPORT
    ══════════════════════════════════════════════════ -->

    <record id="view_report_trainer_revenue_tree" model="ir.ui.view">
        <field name="name">club.report.trainer.revenue.tree</field>
        <field name="model">club.report.trainer.revenue</field>
        <field name="arch" type="xml">
            <list string="Trainer Revenue" create="false" delete="false" edit="false">
                <field name="date"/>
                <field name="trainer_id"/>
                <field name="branch_id"/>
                <field name="specialization"/>
                <field name="attended_count"/>
                <field name="session_revenue" sum="Total Revenue"/>
                <field name="commission_pct" string="%"/>
                <field name="commission_amount" sum="Total Commission"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'confirmed'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_report_trainer_revenue_pivot" model="ir.ui.view">
        <field name="name">club.report.trainer.revenue.pivot</field>
        <field name="model">club.report.trainer.revenue</field>
        <field name="arch" type="xml">
            <pivot string="Trainer Revenue" disable_linking="True">
                <field name="trainer_id" type="row"/>
                <field name="branch_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="session_revenue" type="measure"/>
                <field name="commission_amount" type="measure"/>
                <field name="attended_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_report_trainer_revenue_graph" model="ir.ui.view">
        <field name="name">club.report.trainer.revenue.graph</field>
        <field name="model">club.report.trainer.revenue</field>
        <field name="arch" type="xml">
            <graph string="Trainer Revenue" type="bar">
                <field name="trainer_id" type="row"/>
                <field name="commission_amount" type="measure"/>
                <field name="session_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_report_trainer_revenue_search" model="ir.ui.view">
        <field name="name">club.report.trainer.revenue.search</field>
        <field name="model">club.report.trainer.revenue</field>
        <field name="arch" type="xml">
            <search string="Trainer Revenue">
                <field name="trainer_id"/>
                <field name="branch_id"/>
                <separator/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Pending" name="pending" domain="[('state', 'in', ('draft', 'confirmed'))]"/>
                <group>
                    <filter string="Trainer" name="group_trainer" context="{'group_by': 'trainer_id'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Sport" name="group_sport" context="{'group_by': 'specialization'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_trainer_revenue" model="ir.actions.act_window">
        <field name="name">Trainer Revenue</field>
        <field name="res_model">club.report.trainer.revenue</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_trainer_revenue_search"/>
    </record>

    <!-- ══════════════════════════════════════════════════
         CASH / REVENUE REPORT
    ══════════════════════════════════════════════════ -->

    <record id="view_report_cash_tree" model="ir.ui.view">
        <field name="name">club.report.cash.tree</field>
        <field name="model">club.report.cash</field>
        <field name="arch" type="xml">
            <list string="Cash Report" create="false" delete="false" edit="false">
                <field name="date"/>
                <field name="reference"/>
                <field name="source" widget="badge"/>
                <field name="branch_id"/>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <field name="amount" sum="Total"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state == 'paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"/>
            </list>
        </field>
    </record>

    <record id="view_report_cash_pivot" model="ir.ui.view">
        <field name="name">club.report.cash.pivot</field>
        <field name="model">club.report.cash</field>
        <field name="arch" type="xml">
            <pivot string="Cash Report" disable_linking="True">
                <field name="branch_id" type="row"/>
                <field name="payment_method" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_report_cash_graph" model="ir.ui.view">
        <field name="name">club.report.cash.graph</field>
        <field name="model">club.report.cash</field>
        <field name="arch" type="xml">
            <graph string="Revenue by Branch &amp; Method" type="bar" stacked="True">
                <field name="branch_id" type="row"/>
                <field name="payment_method" type="col"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_report_cash_search" model="ir.ui.view">
        <field name="name">club.report.cash.search</field>
        <field name="model">club.report.cash</field>
        <field name="arch" type="xml">
            <search string="Cash Report">
                <field name="branch_id"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <separator/>
                <filter string="Cash" name="cash" domain="[('payment_method', '=', 'cash')]"/>
                <filter string="Card" name="card" domain="[('payment_method', '=', 'card')]"/>
                <filter string="Online" name="online" domain="[('payment_method', '=', 'online')]"/>
                <filter string="Transfer" name="transfer" domain="[('payment_method', '=', 'transfer')]"/>
                <separator/>
                <filter string="Paid" name="paid" domain="[('payment_state', '=', 'paid')]"/>
                <filter string="Unpaid" name="unpaid" domain="[('payment_state', 'in', ('not_paid', False))]"/>
                <separator/>
                <filter string="Memberships" name="memberships" domain="[('source', '=', 'membership')]"/>
                <filter string="Rentals" name="rentals" domain="[('source', '=', 'rental')]"/>
                <group>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Payment Method" name="group_method" context="{'group_by': 'payment_method'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_cash" model="ir.actions.act_window">
        <field name="name">Cash &amp; Revenue</field>
        <field name="res_model">club.report.cash</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_cash_search"/>
        <field name="context">{'search_default_group_branch': 1, 'search_default_group_method': 1}</field>
    </record>

</odoo>
