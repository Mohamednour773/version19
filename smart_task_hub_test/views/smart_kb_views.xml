<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═════════════════════════════════════════════════ -->
    <record id="smart_kb_list_view" model="ir.ui.view">
        <field name="name">smart.knowledge.base.list</field>
        <field name="model">smart.knowledge.base</field>
        <field name="arch" type="xml">
            <list string="Knowledge Base">
                <field name="name"/>
                <field name="odoo_module"/>
                <field name="task_type"/>
                <field name="root_cause"/>
                <field name="complexity"/>
                <field name="risk_level"/>
                <field name="priority_score"/>
                <field name="solution_type"/>
                <field name="usage_count"/>
                <field name="tags" optional="show"/>
                <field name="is_published"/>
            </list>
        </field>
    </record>

    <record id="smart_kb_form_view" model="ir.ui.view">
        <field name="name">smart.knowledge.base.form</field>
        <field name="model">smart.knowledge.base</field>
        <field name="arch" type="xml">
            <form string="KB Article">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="odoo_module"/>
                            <field name="task_type"/>
                            <field name="root_cause"/>
                            <field name="solution_type"/>
                            <field name="complexity"/>
                            <field name="risk_level"/>
                        </group>
                        <group>
                            <field name="priority_score"/>
                            <field name="usage_count"/>
                            <field name="is_published"/>
                            <field name="tags"/>
                            <field name="source_task_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Problem Description">
                            <field name="problem_description"/>
                        </page>
                        <page string="Root Cause Detail">
                            <field name="root_cause_detail"/>
                        </page>
                        <page string="Solution">
                            <field name="solution_content"/>
                        </page>
                        <page string="Prevention">
                            <field name="prevention_notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_smart_knowledge_base" model="ir.actions.act_window">
        <field name="name">Knowledge Base</field>
        <field name="res_model">smart.knowledge.base</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>