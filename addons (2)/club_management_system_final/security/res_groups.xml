<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════
             ODOO 19: res.groups now uses privilege_id
             (M2O to res.groups.privilege) instead of
             the old category_id / ir.module.category.
        ═══════════════════════════════════════════ -->
        <record id="privilege_club_management" model="res.groups.privilege">
            <field name="name">Club Management</field>
        </record>

        <!-- ═══════════════════════════════════════════
             SECURITY GROUPS
        ═══════════════════════════════════════════ -->

        <!-- Admin: Full access to all club data -->
        <record id="group_club_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_club_management"/>
            <field name="comment">Full access to all club management features and all branches.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager: Manages one branch, cannot change global config -->
        <record id="group_club_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_club_management"/>
            <field name="comment">Manages a specific branch. Can create classes, sessions, memberships.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Reception: Front-desk operations -->
        <record id="group_club_reception" model="res.groups">
            <field name="name">Reception</field>
            <field name="privilege_id" ref="privilege_club_management"/>
            <field name="comment">Front-desk staff. Can manage memberships, attendance and rentals.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Trainer: Read-only on their own sessions and attendance -->
        <record id="group_club_trainer" model="res.groups">
            <field name="name">Trainer</field>
            <field name="privilege_id" ref="privilege_club_management"/>
            <field name="comment">Trainer role. Can view own sessions and mark attendance.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
