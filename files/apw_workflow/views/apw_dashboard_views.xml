<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard: all pending approval lines, with inline Approve/Refuse -->
    <record id="view_apw_line_dashboard_list" model="ir.ui.view">
        <field name="name">apw.request.line.dashboard.list</field>
        <field name="model">apw.request.line</field>
        <field name="arch" type="xml">
            <list string="Pending Approvals"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'"
                  decoration-muted="state == 'cancelled'">
                <field name="request_id" string="Request Ref"/>
                <field name="res_name"   string="Document"/>
                <field name="res_model"  string="Model" optional="hide"/>
                <field name="config_id"  string="Workflow"/>
                <field name="stage_name" string="Stage"/>
                <field name="approver_id" string="Approver"/>
                <field name="state" string="Decision"/>
                <field name="date_decided" string="Date"/>
                <field name="note" string="Comment" optional="hide"/>
                <button name="action_approve" string="Approve"
                        type="object" invisible="state != 'pending'"/>
                <button name="action_refuse"  string="Refuse"
                        type="object" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="action_apw_dashboard" model="ir.actions.act_window">
        <field name="name">All Pending Approvals</field>
        <field name="res_model">apw.request.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state','=','pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No pending approvals!</p>
        </field>
    </record>

    <record id="action_apw_my_queue" model="ir.actions.act_window">
        <field name="name">My Approval Queue</field>
        <field name="res_model">apw.request.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('approver_id','=',uid),('state','=','pending')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Your approval queue is empty!</p>
        </field>
    </record>

</odoo>
