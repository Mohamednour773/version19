<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custody_settlement_wizard_form" model="ir.ui.view">
        <field name="name">custody.settlement.wizard.form</field>
        <field name="model">custody.settlement.wizard</field>
        <field name="arch" type="xml">
            <form string="Settle Custody">
                <group>
                    <field name="employee_id"/>
                    <field name="request_ids" widget="many2many_tags" readonly="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="request_id"/>
                        <field name="type"/>
                        <field name="description"/>
                        <field name="amount"/>
                        <field name="journal_id" invisible="type != 'return_cash'" required="type == 'return_cash'"/>
                        <field name="account_id" invisible="type != 'expense'" required="type == 'expense'"/>
                        <field name="bill_id" invisible="type != 'vendor_bill'" required="type == 'vendor_bill'"/>
                        <field name="currency_id" column_invisible="True"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Create Settlements" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
