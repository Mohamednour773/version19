<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="view_pdc_check_list" model="ir.ui.view">
        <field name="name">pdc.check.list</field>
        <field name="model">pdc.check</field>
        <field name="arch" type="xml">
            <list string="PDC Checks"
                  decoration-success="state in ('cleared','paid','settled')"
                  decoration-danger="state in ('bounced','cancelled')"
                  decoration-warning="state in ('under_collection','delivered','printed')"
                  decoration-info="state == 'registered'"
                  decoration-muted="state in ('returned',)">
                <field name="name"/>
                <field name="check_type" widget="badge"
                       decoration-success="check_type in ('received','guarantee_received')"
                       decoration-warning="check_type in ('issued','guarantee_issued')"/>
                <field name="check_number"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="issue_date" optional="show"/>
                <field name="due_date"/>
                <field name="days_to_due" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('cleared','paid','settled')"
                       decoration-danger="state in ('bounced','cancelled')"
                       decoration-warning="state in ('under_collection','delivered','printed')"
                       decoration-info="state == 'registered'"/>
                <field name="responsible_id" optional="show"/>
                <field name="is_overdue" optional="show"/>
                <field name="journal_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="view_pdc_check_form" model="ir.ui.view">
        <field name="name">pdc.check.form</field>
        <field name="model">pdc.check</field>
        <field name="arch" type="xml">
            <form string="PDC Check">
                <!-- Hidden fields required by modifier expressions in header + body.
                     Odoo 17 CE requires every field referenced in invisible/readonly/required
                     to be declared as a <field> somewhere in the view arch. -->
                <field name="can_register" invisible="1"/>
                <field name="can_deposit" invisible="1"/>
                <field name="can_clear" invisible="1"/>
                <field name="can_print" invisible="1"/>
                <field name="can_deliver" invisible="1"/>
                <field name="can_pay" invisible="1"/>
                <field name="can_bounce" invisible="1"/>
                <field name="can_settle" invisible="1"/>
                <field name="can_activate_guarantee" invisible="1"/>
                <field name="can_return_guarantee" invisible="1"/>
                <field name="can_cancel" invisible="1"/>
                <field name="partner_pdc_blocked" invisible="1"/>
                <field name="is_overdue" invisible="1"/>
                <field name="is_due_soon" invisible="1"/>

                <header>
                    <!-- Received flow buttons (→ Phase 5 wizards for input-heavy ops) -->
                    <button name="action_open_register_wizard" string="Register"
                            type="object" class="oe_highlight"
                            invisible="not can_register"/>
                    <button name="action_open_deposit_wizard" string="Deposit"
                            type="object" class="oe_highlight"
                            invisible="not can_deposit"/>
                    <button name="action_open_clear_wizard" string="Mark Cleared"
                            type="object" class="oe_highlight"
                            invisible="not can_clear"/>
                    <!-- Issued flow buttons -->
                    <button name="action_open_print_check_wizard" string="Print Check"
                            type="object" class="oe_highlight"
                            invisible="not can_print"/>
                    <button name="action_deliver" string="Mark Delivered"
                            type="object" class="oe_highlight"
                            invisible="not can_deliver"/>
                    <button name="action_pay" string="Mark Paid"
                            type="object" class="oe_highlight"
                            invisible="not can_pay"/>
                    <!-- Common: bounce / settle -->
                    <button name="action_open_bounce_wizard" string="Record Bounce"
                            type="object"
                            invisible="not can_bounce"/>
                    <button name="action_settle" string="Settle Bounce"
                            type="object" class="oe_highlight"
                            invisible="not can_settle"/>
                    <!-- Guarantee flow buttons (no extra input needed — direct) -->
                    <button name="action_activate_guarantee" string="Activate Guarantee"
                            type="object" class="oe_highlight"
                            invisible="not can_activate_guarantee"/>
                    <button name="action_return_guarantee" string="Return Guarantee"
                            type="object"
                            invisible="not can_return_guarantee"/>
                    <!-- Cancel — manager only → wizard for reason + confirmation -->
                    <button name="action_open_cancel_wizard" string="Cancel"
                            type="object"
                            invisible="not can_cancel"
                            groups="pdc_management_v19.group_pdc_manager"/>

                    <!-- Option B: Conditional statusbar — one per check_type family.
                         Only the matching one is visible; all show the correct step
                         progression for that workflow. -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,registered,under_collection,cleared"
                           invisible="check_type not in ('received',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,registered,printed,delivered,paid"
                           invisible="check_type not in ('issued',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,registered,returned"
                           invisible="check_type not in ('guarantee_received','guarantee_issued')"/>
                </header>

                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo"
                                   string="Journal Entries"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo"
                                   string="Invoices"/>
                        </button>
                        <button name="action_view_operations" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <field name="operation_count" widget="statinfo"
                                   string="Operations"/>
                        </button>
                    </div>

                    <!-- Alert Banners -->
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="not partner_pdc_blocked">
                        <strong>Warning:</strong> This partner is PDC-blocked due to
                        excessive bounced checks.
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="not is_overdue">
                        This check is <strong>overdue</strong> — due date has passed.
                    </div>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="not is_due_soon">
                        This check is <strong>due soon</strong> —
                        <field name="days_to_due" readonly="1" nolabel="1"
                               class="d-inline"/> day(s) remaining.
                    </div>
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="not was_guarantee">
                        Originally registered as a guarantee check. Accounting entries
                        apply from the activation date.
                    </div>

                    <!-- Title / Substate -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                        <h4 class="text-muted">
                            <field name="substate" readonly="1" nolabel="1"/>
                        </h4>
                    </div>

                    <!-- Row 1: Check Details + Financial -->
                    <group>
                        <group string="Check Details">
                            <field name="check_type"
                                   readonly="state not in ('draft',)"/>
                            <field name="check_number"
                                   readonly="state not in ('draft','registered')"/>
                            <field name="check_book_id"
                                   invisible="check_type not in ('issued','guarantee_issued')"
                                   readonly="state not in ('draft',)"
                                   domain="[('state','=','active'),('journal_id','=',journal_id)]"/>
                            <field name="bank_id"
                                   readonly="state not in ('draft','registered')"/>
                            <field name="branch"
                                   readonly="state not in ('draft','registered')"/>
                            <field name="was_guarantee" readonly="1"
                                   invisible="not was_guarantee"/>
                        </group>
                        <group string="Financial">
                            <field name="amount"
                                   readonly="state not in ('draft','registered')"/>
                            <field name="currency_id"
                                   readonly="state not in ('draft','registered')"/>
                            <field name="journal_id"
                                   readonly="state not in ('draft',)"
                                   domain="[('type','=','bank')]"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="state not in ('draft',)"/>
                        </group>
                    </group>

                    <!-- Row 2: Parties + Dates -->
                    <group>
                        <group string="Parties">
                            <field name="partner_id"
                                   readonly="state not in ('draft','registered')"/>
                            <field name="drawer_name"
                                   invisible="check_type not in ('received','guarantee_received')"
                                   placeholder="Name on the check (drawer)"/>
                            <field name="payee_name"
                                   invisible="check_type not in ('issued','guarantee_issued')"
                                   placeholder="Name of beneficiary (payee)"/>
                            <field name="signatory"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Dates">
                            <field name="issue_date"
                                   readonly="state not in ('draft','registered')"/>
                            <field name="due_date"
                                   readonly="state not in ('draft','registered')"/>
                            <field name="issue_date_hijri" readonly="1"
                                   invisible="not company_id.pdc_use_hijri"/>
                            <field name="due_date_hijri" readonly="1"
                                   invisible="not company_id.pdc_use_hijri"/>
                        </group>
                    </group>

                    <!-- Amount in Words (hidden in draft; Arabic only when Arabic layout enabled) -->
                    <group string="Amount in Words"
                           invisible="state == 'draft'">
                        <field name="amount_in_words" readonly="1" nolabel="1"/>
                        <field name="amount_in_words_ar" readonly="1" nolabel="1"
                               invisible="not company_id.pdc_default_layout_ar"/>
                    </group>

                    <!-- Notebook -->
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="narration"
                                   placeholder="Internal notes, instructions, or comments about this check..."/>
                        </page>

                        <page string="Banking Details" name="banking">
                            <group>
                                <group string="Collection">
                                    <field name="deposit_date"/>
                                    <field name="deposit_journal_id"
                                           domain="[('type','=','bank')]"/>
                                    <field name="clear_date"/>
                                </group>
                            </group>
                        </page>

                        <page string="Bounce Info" name="bounce"
                              invisible="not can_bounce and state not in ('bounced','settled')">
                            <group>
                                <group string="Bounce Details">
                                    <field name="bounce_date"/>
                                    <field name="bounce_reason_id"/>
                                    <field name="bounce_charges"/>
                                </group>
                                <group string="Charges Source">
                                    <field name="bounce_charges_source"/>
                                    <field name="bounce_charges_account_id"
                                           invisible="bounce_charges_source != 'custom_account'"
                                           required="bounce_charges_source == 'custom_account'
                                                     and state in ('bounced', 'settled')"/>
                                </group>
                            </group>
                            <group>
                                <group string="Settlement">
                                    <field name="settled_date"
                                           invisible="state != 'settled'"/>
                                </group>
                            </group>
                            <field name="bounce_notes"
                                   placeholder="Notes about the bounce, follow-up actions, and any arrangements made..."/>
                        </page>

                        <page string="Invoices" name="invoices"
                              invisible="invoice_count == 0">
                            <field name="invoice_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="move_type"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_total" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="payment_state" widget="badge"
                                           decoration-success="payment_state == 'paid'"
                                           decoration-warning="payment_state == 'partial'"
                                           decoration-danger="payment_state == 'not_paid'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Operations" name="operations">
                            <field name="operation_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="operation_date"/>
                                    <field name="operation_type" widget="badge"
                                           decoration-success="operation_type in ('clear','pay','settle')"
                                           decoration-danger="operation_type in ('bounce','cancel')"
                                           decoration-info="operation_type in ('register','activate_guarantee')"
                                           decoration-warning="operation_type in ('deposit','deliver','print')"/>
                                    <field name="from_state"/>
                                    <field name="to_state"/>
                                    <field name="user_id"/>
                                    <field name="move_id"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Attachments" name="images">
                            <group>
                                <group string="Front Side">
                                    <field name="check_image_front"
                                           widget="image" nolabel="1"
                                           style="max-width: 400px; border: 1px solid #dee2e6; border-radius: 4px;"/>
                                </group>
                                <group string="Back Side">
                                    <field name="check_image_back"
                                           widget="image" nolabel="1"
                                           style="max-width: 400px; border: 1px solid #dee2e6; border-radius: 4px;"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Kanban View ───────────────────────────────────────────────────── -->
    <record id="view_pdc_check_kanban" model="ir.ui.view">
        <field name="name">pdc.check.kanban</field>
        <field name="model">pdc.check</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="check_number"/>
                <field name="partner_id"/>
                <field name="bank_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="check_type"/>
                <field name="color"/>
                <field name="is_overdue"/>
                <field name="is_due_soon"/>
                <field name="is_bounced"/>
                <field name="was_guarantee"/>
                <field name="responsible_id"/>
                <field name="display_amount"/>
                <field name="days_to_due"/>
                <templates>
                    <t t-name="card" t-att-color="record.color.raw_value">
                        <!-- Header: check number (prominent) + urgency badges -->
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <strong class="o_kanban_record_title fs-6">
                                    #<field name="check_number"/>
                                </strong>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    <field name="name"/>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1 align-items-end ms-2">
                                <span t-if="record.is_overdue.raw_value"
                                      class="badge text-bg-danger">Overdue</span>
                                <span t-elif="record.is_due_soon.raw_value"
                                      class="badge text-bg-warning">Due Soon</span>
                                <span t-if="record.is_bounced.raw_value"
                                      class="badge text-bg-danger">
                                    <i class="fa fa-exclamation-triangle me-1"/>Bounced
                                </span>
                                <span t-if="record.was_guarantee.raw_value"
                                      class="badge text-bg-secondary"
                                      style="font-size: 0.6rem;">ex-Guarantee</span>
                            </div>
                        </div>
                        <!-- Partner + Bank -->
                        <div class="text-muted small">
                            <field name="partner_id"/> — <field name="bank_id"/>
                        </div>
                        <!-- Amount + Due Date -->
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <span class="fw-bold">
                                <field name="display_amount"/>
                            </span>
                            <span class="text-muted small">
                                <field name="due_date"/>
                                <t t-if="record.days_to_due.raw_value >= 0">
                                    (<field name="days_to_due"/>d)
                                </t>
                            </span>
                        </div>
                        <!-- Footer: responsible + type badge -->
                        <div class="mt-1 d-flex justify-content-between align-items-center small text-muted">
                            <span><field name="responsible_id"/></span>
                            <span class="badge text-bg-light border">
                                <field name="check_type"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────────────── -->
    <record id="view_pdc_check_search" model="ir.ui.view">
        <field name="name">pdc.check.search</field>
        <field name="model">pdc.check</field>
        <field name="arch" type="xml">
            <search string="Search PDC Checks">
                <field name="name" string="Reference"/>
            </search>
        </field>
    </record>

    <!-- ── Pivot View ────────────────────────────────────────────────────── -->
    <record id="view_pdc_check_pivot" model="ir.ui.view">
        <field name="name">pdc.check.pivot</field>
        <field name="model">pdc.check</field>
        <field name="arch" type="xml">
            <pivot string="PDC Analysis" disable_linking="1">
                <field name="check_type" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ── Graph View ────────────────────────────────────────────────────── -->
    <record id="view_pdc_check_graph" model="ir.ui.view">
        <field name="name">pdc.check.graph</field>
        <field name="model">pdc.check</field>
        <field name="arch" type="xml">
            <graph string="PDC Checks" type="bar">
                <field name="due_date" type="col" interval="month"/>
                <field name="check_type" type="row"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ── Calendar View ─────────────────────────────────────────────────── -->
    <record id="view_pdc_check_calendar" model="ir.ui.view">
        <field name="name">pdc.check.calendar</field>
        <field name="model">pdc.check</field>
        <field name="arch" type="xml">
            <calendar string="PDC Due Dates"
                      date_start="due_date"
                      color="state"
                      mode="month"
                      quick_create="0">
                <field name="name"/>
                <field name="check_number"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="check_type" filters="1" string="Type"/>
                <field name="state" filters="1" string="Status"/>
            </calendar>
        </field>
    </record>

    <!-- ═════════════════════════════════════════════════════════════════════
         ACTIONS  (9 total: 8 spec + 1 bonus overdue)
    ═════════════════════════════════════════════════════════════════════ -->

    <!-- 1. All PDC Checks -->
    <record id="action_pdc_check" model="ir.actions.act_window">
        <field name="name">All PDC Checks</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar</field>
        <field name="context">{'search_default_active_checks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No PDC checks recorded yet.</p>
            <p>Create your first check to get started.</p>
        </field>
    </record>

    <!-- 2. Received Checks -->
    <record id="action_pdc_check_received" model="ir.actions.act_window">
        <field name="name">Received Checks</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar</field>
        <field name="domain">[('check_type','=','received')]</field>
        <field name="context">{
            'default_check_type': 'received',
            'search_default_active_checks': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No received checks yet.</p>
            <p>Record post-dated checks received from customers.</p>
        </field>
    </record>

    <!-- 3. Issued Checks -->
    <record id="action_pdc_check_issued" model="ir.actions.act_window">
        <field name="name">Issued Checks</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,kanban,form,pivot,graph,calendar</field>
        <field name="domain">[('check_type','=','issued')]</field>
        <field name="context">{
            'default_check_type': 'issued',
            'search_default_active_checks': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No issued checks yet.</p>
            <p>Record post-dated checks issued to suppliers.</p>
        </field>
    </record>

    <!-- 4. Guarantee Checks (combined — received and issued guarantee types) -->
    <record id="action_pdc_check_guarantee" model="ir.actions.act_window">
        <field name="name">Guarantee Checks</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_type','in',['guarantee_received','guarantee_issued'])]</field>
        <field name="context">{'search_default_active_checks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No guarantee checks yet.</p>
            <p>Guarantee checks are off-balance-sheet. Activate them when
               enforcement becomes necessary.</p>
        </field>
    </record>

    <!-- 5. Under Collection -->
    <record id="action_pdc_check_under_collection" model="ir.actions.act_window">
        <field name="name">Under Collection</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state','=','under_collection')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checks currently under collection.</p>
        </field>
    </record>

    <!-- 6. Due Soon -->
    <record id="action_pdc_check_due_soon" model="ir.actions.act_window">
        <field name="name">Due Soon</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_due_soon','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checks due soon.</p>
        </field>
    </record>

    <!-- 7. Overdue (bonus — useful for daily operations) -->
    <record id="action_pdc_check_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Checks</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_overdue','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No overdue checks.</p>
        </field>
    </record>

    <!-- 8. Bounced Checks -->
    <record id="action_pdc_check_bounced" model="ir.actions.act_window">
        <field name="name">Bounced Checks</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state','=','bounced')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bounced checks. All clear!</p>
        </field>
    </record>

    <!-- 9. My Checks -->
    <record id="action_pdc_check_my" model="ir.actions.act_window">
        <field name="name">My Checks</field>
        <field name="res_model">pdc.check</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('responsible_id','=',uid)]</field>
        <field name="context">{
            'default_responsible_id': uid,
            'search_default_active_checks': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No checks assigned to you.</p>
        </field>
    </record>

</odoo>
