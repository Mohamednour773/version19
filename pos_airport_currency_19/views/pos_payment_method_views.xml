<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_airport_currency" model="ir.ui.view">
        <field name="name">pos.payment.method.form.airport.currency</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="airport_currency_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_airport_currency" model="ir.ui.view">
        <field name="name">pos.payment.method.list.airport.currency</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="airport_currency_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
