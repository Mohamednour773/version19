<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_factory_site_expense_list" model="ir.ui.view">
        <field name="name">factory.site.expense.list</field>
        <field name="model">factory.site.expense</field>
        <field name="arch" type="xml">
            <list string="Site Expenses | مصاريف الموقع">
                <field name="date"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="sector_id"/>
                <field name="installation_id"/>
                <field name="expense_category"/>
                <field name="amount" sum="Total" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="paid_by"/>
            </list>
        </field>
    </record>

    <record id="action_factory_site_expense" model="ir.actions.act_window">
        <field name="name">Site Expenses | مصاريف الموقع</field>
        <field name="res_model">factory.site.expense</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
