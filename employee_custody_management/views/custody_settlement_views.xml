<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custody_settlement_list" model="ir.ui.view">
        <field name="name">custody.settlement.list</field>
        <field name="model">custody.settlement</field>
        <field name="arch" type="xml">
            <list string="Custody Settlements" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="settlement_date"/>
                <field name="request_id"/>
                <field name="employee_id"/>
                <field name="total_settled" widget="monetary"/>
                <field name="currency_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_custody_settlement_form" model="ir.ui.view">
        <field name="name">custody.settlement.form</field>
        <field name="model">custody.settlement</field>
        <field name="arch" type="xml">
            <form string="Custody Settlement">
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" groups="employee_custody_management.group_custody_manager" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <field name="partner_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="request_id" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="settlement_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_settled" widget="monetary" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="type"/>
                            <field name="description"/>
                            <field name="amount" widget="monetary"/>
                            <field name="journal_id" invisible="type != 'return_cash'" required="type == 'return_cash'"/>
                            <field name="account_id" invisible="type != 'expense'" required="type == 'expense'"/>
                            <field name="bill_id" invisible="type != 'vendor_bill'" required="type == 'vendor_bill'"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                        <form>
                            <group>
                                <field name="type"/>
                                <field name="description"/>
                                <field name="amount" widget="monetary"/>
                                <field name="journal_id" invisible="type != 'return_cash'" required="type == 'return_cash'"/>
                                <field name="account_id" invisible="type != 'expense'" required="type == 'expense'"/>
                                <field name="bill_id" invisible="type != 'vendor_bill'" required="type == 'vendor_bill'"/>
                                <field name="analytic_precision" invisible="1"/>
                                <field name="analytic_distribution" widget="analytic_distribution" invisible="type != 'expense'"/>
                            </group>
                        </form>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_custody_settlement_search" model="ir.ui.view">
        <field name="name">custody.settlement.search</field>
        <field name="model">custody.settlement</field>
        <field name="arch" type="xml">
            <search string="Custody Settlements">
                <field name="name"/>
                <field name="request_id"/>
                <field name="employee_id"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_custody_settlement" model="ir.actions.act_window">
        <field name="name">Custody Settlements</field>
        <field name="res_model">custody.settlement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
