<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_smart_excel_generator_form" model="ir.ui.view">
        <field name="name">smart.excel.generator.form</field>
        <field name="model">smart.excel.generator</field>
        <field name="arch" type="xml">
            <form string="Excel Generator">
                <header>
                    <button name="action_generate"
                            string="Generate Excel Files"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft','error']"/>
                    <button name="action_reset"
                            string="Reset"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. ABC Company — Chart of Accounts 2024"/></h1>
                    </div>

                    <!-- Done: show download buttons prominently -->
                    <div invisible="state != 'done'"
                         style="background:#d4edda;border:1px solid #c3e6cb;border-radius:8px;padding:16px;margin-bottom:16px;">
                        <h4 style="color:#155724;margin-bottom:12px;">✅ Files Ready — Download Below</h4>
                        <div style="display:flex;gap:16px;flex-wrap:wrap;">
                            <div style="flex:1;min-width:200px;background:white;border-radius:6px;padding:12px;border:1px solid #c3e6cb;">
                                <div style="font-weight:bold;color:#1F5C99;margin-bottom:6px;">
                                    📊 Chart of Accounts
                                </div>
                                <div style="font-size:12px;color:#6c757d;margin-bottom:8px;">
                                    <field name="coa_count"/> accounts — Import in Odoo first
                                </div>
                                <field name="coa_file" filename="coa_filename" widget="binary"
                                       string="Download COA Excel"/>
                            </div>
                            <div style="flex:1;min-width:200px;background:white;border-radius:6px;padding:12px;border:1px solid #c3e6cb;">
                                <div style="font-weight:bold;color:#1F5C99;margin-bottom:6px;">
                                    📒 Opening Entries
                                </div>
                                <div style="font-size:12px;color:#6c757d;margin-bottom:8px;">
                                    <field name="oe_count"/> lines —
                                    <span style="color:#198754;" invisible="not is_balanced">Balanced ✅</span>
                                    <span style="color:#dc3545;" invisible="is_balanced">NOT Balanced ⚠️</span>
                                </div>
                                <field name="oe_file" filename="oe_filename" widget="binary"
                                       string="Download OE Excel"/>
                            </div>
                        </div>
                    </div>

                    <!-- Error message -->
                    <div invisible="state != 'error'"
                         style="background:#f8d7da;border:1px solid #f5c6cb;border-radius:8px;padding:12px;margin-bottom:16px;">
                        <strong style="color:#721c24;">❌ Error:</strong>
                        <field name="error_message" readonly="1" style="color:#721c24;"/>
                    </div>

                    <group>
                        <group string="Input Settings">
                            <field name="client_id"/>
                            <field name="task_id" domain="[('client_id','=',client_id)]"/>
                            <field name="input_type"/>
                            <field name="odoo_version"/>
                            <field name="fiscal_year_start"/>
                        </group>
                        <group string="Statistics" invisible="state != 'done'">
                            <field name="coa_count" readonly="1"/>
                            <field name="oe_count" readonly="1"/>
                            <field name="total_debit" readonly="1" widget="monetary"/>
                            <field name="total_credit" readonly="1" widget="monetary"/>
                            <field name="is_balanced" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Upload File" name="upload">
                            <group>
                                <field name="input_file" widget="binary"
                                       filename="input_filename"
                                       string="Upload Excel / CSV"
                                       help="Upload the trial balance or account list from the client"/>
                                <field name="input_filename" invisible="1"/>
                            </group>
                            <div style="background:#e8f4fd;border-radius:6px;padding:12px;margin-top:8px;">
                                <strong>Accepted formats:</strong> .xlsx, .xls, .csv<br/>
                                <strong>Expected columns for Trial Balance:</strong>
                                Account Code | Account Name | Debit Balance | Credit Balance<br/>
                                <strong>Expected columns for Account List:</strong>
                                Account Code | Account Name | Account Type | Group
                            </div>
                            <separator string="Or paste data directly"/>
                            <field name="input_text"
                                   placeholder="Paste tab-separated or CSV data here (header row required)..."
                                   widget="text"
                                   style="font-family:monospace;font-size:12px;min-height:120px;"/>
                        </page>

                        <page string="AI Analysis" name="analysis" invisible="not ai_analysis">
                            <field name="ai_analysis" widget="html" readonly="1"/>
                        </page>

                        <page string="Chatter" name="chatter">
                            <div class="oe_chatter">
                                <field name="message_follower_ids"/>
                                <field name="message_ids"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_smart_excel_generator_list" model="ir.ui.view">
        <field name="name">smart.excel.generator.list</field>
        <field name="model">smart.excel.generator</field>
        <field name="arch" type="xml">
            <list string="Excel Generators" decoration-success="state=='done'"
                  decoration-danger="state=='error'"
                  decoration-info="state=='processing'">
                <field name="name"/>
                <field name="client_id"/>
                <field name="input_type"/>
                <field name="odoo_version"/>
                <field name="coa_count"/>
                <field name="oe_count"/>
                <field name="is_balanced"/>
                <field name="state" widget="badge"
                       decoration-success="state=='done'"
                       decoration-danger="state=='error'"
                       decoration-warning="state=='processing'"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_smart_excel_generator" model="ir.actions.act_window">
        <field name="name">Excel Generator</field>
        <field name="res_model">smart.excel.generator</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_odoo_version': 'Odoo 19'}</field>
    </record>

</odoo>
