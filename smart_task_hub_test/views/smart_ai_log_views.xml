<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="smart_ai_log_list_view" model="ir.ui.view">
        <field name="name">smart.ai.log.list</field>
        <field name="model">smart.ai.log</field>
        <field name="arch" type="xml">
            <list string="AI API Logs" create="false" edit="false">
                <field name="create_date"       string="Date"/>
                <field name="provider"/>
                <field name="model"/>
                <field name="prompt_tokens"/>
                <field name="completion_tokens"/>
                <field name="total_tokens"/>
                <field name="estimated_cost_usd" string="Est. Cost $"/>
            </list>
        </field>
    </record>
    <record id="action_smart_ai_log" model="ir.actions.act_window">
        <field name="name">AI API Logs</field>
        <field name="res_model">smart.ai.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>