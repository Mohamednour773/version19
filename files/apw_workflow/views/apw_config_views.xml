<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_apw_config_list" model="ir.ui.view">
        <field name="name">apw.config.list</field>
        <field name="model">apw.config</field>
        <field name="arch" type="xml">
            <list string="APW Workflow Configurations" decoration-muted="not active">
                <field name="name"/>
                <field name="model_id"/>
                <field name="stage_count" string="Stages"/>
                <field name="pending_count" string="Pending"/>
                <field name="request_count" string="Requests"/>
                <field name="block_write" widget="boolean_toggle"/>
                <field name="block_unlink" widget="boolean_toggle"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_apw_config_form" model="ir.ui.view">
        <field name="name">apw.config.form</field>
        <field name="model">apw.config</field>
        <field name="arch" type="xml">
            <form string="APW Workflow Configuration">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-check-circle">
                            <div class="o_stat_info">
                                <field name="pending_count" class="o_stat_value"/>
                                <span class="o_stat_text">Pending</span>
                            </div>
                        </button>
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <div class="o_stat_info">
                                <field name="request_count" class="o_stat_value"/>
                                <span class="o_stat_text">Requests</span>
                            </div>
                        </button>
                        <button name="action_view_stages" type="object"
                                class="oe_stat_button" icon="fa-sitemap">
                            <div class="o_stat_info">
                                <field name="stage_count" class="o_stat_value"/>
                                <span class="o_stat_text">Stages</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Workflow Name..."/>
                        </h1>
                        <h2>
                            <field name="model_id" placeholder="Select target model..."
                                   options="{'no_create': True, 'no_open': True}"/>
                        </h2>
                    </div>
                    <group>
                        <group string="General">
                            <field name="model_name" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="description"/>
                        </group>
                        <group string="Email Notifications">
                            <field name="notify_requester"/>
                            <field name="notify_next_approver"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Approval Stages" name="stages">
                            <field name="stage_ids" widget="one2many">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="approver_user_id"
                                           invisible="approver_type != 'user'"/>
                                    <field name="approver_group_id"
                                           invisible="approver_type != 'group'"/>
                                    <field name="approver_field_id"
                                           invisible="approver_type != 'dynamic'"/>
                                    <field name="approver_display" readonly="1"
                                           string="Resolved As"/>
                                    <field name="require_all_group_members"
                                           invisible="approver_type != 'group'"/>
                                    <field name="allow_self_approval"/>
                                    <field name="auto_approve_if_missing"/>
                                </list>
                            </field>
                            <div class="alert alert-info" invisible="stage_count &gt; 0">
                                <strong>No stages defined yet.</strong>
                                Add approval stages above — they are processed top to bottom.
                            </div>
                        </page>

                        <page string="Action Blocking" name="blocking">
                            <group>
                                <group string="Block These Actions While Approval is Pending">
                                    <field name="block_write"/>
                                    <field name="block_unlink"/>
                                    <field name="block_create"/>
                                    <field name="block_custom_actions"
                                           placeholder="action_confirm,action_validate"/>
                                </group>
                                <group string="Auto-trigger Settings">
                                    <field name="trigger_on_create"/>
                                    <field name="trigger_domain"
                                           placeholder="[('amount_total', '&gt;', 1000)]"/>
                                </group>
                            </group>
                            <div class="alert alert-warning mt-3">
                                <strong>Integration:</strong>
                                To enable blocking on your target model, either inherit
                                <code>apw.mixin</code> and call
                                <code>self._check_apw_block('method_name')</code>,
                                or use <code>self.env['apw.enforcer'].check_and_block(...)</code>
                                in a bridge module. See README for full instructions.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_apw_config_search" model="ir.ui.view">
        <field name="name">apw.config.search</field>
        <field name="model">apw.config</field>
        <field name="arch" type="xml">
            <search string="Search APW Workflows">
                <field name="name"/>
                <field name="model_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Model" name="grp_model" context="{'group_by':'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_apw_config" model="ir.actions.act_window">
        <field name="name">Workflow Configurations</field>
        <field name="res_model">apw.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first APW workflow configuration!
            </p>
            <p>
                Select a model, define sequential approval stages, and configure
                which actions are blocked while approval is pending.
            </p>
        </field>
    </record>

</odoo>
