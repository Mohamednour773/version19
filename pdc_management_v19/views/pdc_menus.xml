<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         PDC MANAGEMENT — MENU STRUCTURE  (matches spec section 11)

         PDC Management  (root, seq=85)
         ├── Dashboard          (placeholder — Phase 5 dashboard action)
         ├── Checks
         │   ├── All Checks
         │   ├── Received Checks
         │   ├── Issued Checks
         │   ├── Guarantee Checks
         │   ├── Under Collection
         │   ├── Due Soon
         │   ├── Bounced
         │   └── My Checks
         ├── Check Books
         ├── Operations Log
         ├── Reports            (placeholder — Phase 4 fills this)
         └── Configuration
             ├── Banks
             ├── Bank Print Layouts
             ├── Bounce Reasons
             └── Settings       (opens res.config.settings / PDC section)
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Root ──────────────────────────────────────────────────────────── -->
    <menuitem id="menu_pdc_root"
              name="PDC Management"
              sequence="85"
              web_icon="pdc_management,static/description/icon.png"
              groups="pdc_management_v19.group_pdc_user"/>


    <!-- action_pdc_dashboard is defined in views/pdc_dashboard_views.xml -->
    <!-- ── Dashboard ───────────────────────────────────────────────────── -->
    <menuitem id="menu_pdc_dashboard"
              name="Dashboard"
              parent="menu_pdc_root"
              sequence="5"
              action="pdc_management_v19.action_pdc_dashboard"
              groups="pdc_management_v19.group_pdc_user"/>

    <!-- ── Checks submenu ────────────────────────────────────────────────── -->
    <menuitem id="menu_pdc_checks"
              name="Checks"
              parent="menu_pdc_root"
              sequence="10"
              groups="pdc_management_v19.group_pdc_user"/>

    <menuitem id="menu_pdc_check_all"
              name="All Checks"
              parent="menu_pdc_checks"
              sequence="10"
              action="action_pdc_check"
              groups="pdc_management_v19.group_pdc_user"/>

    <menuitem id="menu_pdc_check_received"
              name="Received Checks"
              parent="menu_pdc_checks"
