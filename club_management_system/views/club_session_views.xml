<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════
         CALENDAR VIEW — Drag & Drop
         Odoo 17: events are draggable by default
         when datetime_start / datetime_end are set.
         Conflicts are caught by @api.constrains on write().
    ════════════════════════════════════ -->
    <record id="view_club_session_calendar" model="ir.ui.view">
        <field name="name">club.session.calendar</field>
        <field name="model">club.session</field>
        <field name="arch" type="xml">
            <calendar string="Sessions"
                      date_start="datetime_start"
                      date_stop="datetime_end"
                      color="color"
                      mode="week"
                      quick_create="False">
                <field name="name"/>
                <field name="trainer_id" filters="1"/>
                <field name="branch_id" filters="1"/>
                <field name="facility_id"/>
                <field name="enrolled_count"/>
                <field name="max_capacity"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ════════════════════════════════════
         TREE VIEW
    ════════════════════════════════════ -->
    <record id="view_club_session_tree" model="ir.ui.view">
        <field name="name">club.session.tree</field>
        <field name="model">club.session</field>
        <field name="arch" type="xml">
            <list string="Sessions"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'confirmed'"
                  decoration-primary="state == 'in_progress'"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="is_full">
                <field name="date"/>
                <field name="class_id"/>
                <field name="branch_id"/>
                <field name="trainer_id"/>
                <field name="trainer_count" string="Trainers" optional="show"/>
                <field name="facility_id" optional="show"/>
                <field name="time_start" widget="float_time"/>
                <field name="time_end" widget="float_time"/>
                <field name="duration" widget="float_time" optional="show"/>
                <field name="enrolled_count"/>
                <field name="max_capacity"/>
                <field name="attended_count"/>
                <field name="is_full" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'confirmed'"
                       decoration-primary="state == 'in_progress'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════
         FORM VIEW
    ════════════════════════════════════ -->
    <record id="view_club_session_form" model="ir.ui.view">
        <field name="name">club.session.form</field>
        <field name="model">club.session</field>
        <field name="arch" type="xml">
            <form string="Session">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_reschedule" string="Reschedule" type="object"
                            invisible="state in ('done', 'cancelled')" class="btn-secondary"/>
                    <button name="action_start" string="Start Session" type="object"
                            invisible="state != 'confirmed'" class="btn-success"/>
                    <button name="action_take_attendance" string="Take Attendance" type="object"
                            invisible="state not in ('confirmed', 'in_progress', 'done')"
                            class="btn-info"/>
                    <button name="action_done" string="Complete" type="object"
                            invisible="state != 'in_progress'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"
                            confirm="Cancel this session?"/>
                    <button name="action_reset_draft" string="Reset" type="object"
                            invisible="state not in ('cancelled',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <field name="is_full" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_take_attendance" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="attended_count" widget="statinfo" string="Attended"/>
                        </button>
                        <button name="action_take_attendance" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="enrolled_count" widget="statinfo" string="Enrolled"/>
                        </button>
                        <button name="action_reschedule" type="object"
                                class="oe_stat_button" icon="fa-calendar-o"
                                invisible="state in ('done', 'cancelled')">
                            <span class="o_stat_text">Reschedule</span>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_full">
                        <i class="fa fa-warning"/> This session is fully booked.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Session Info">
                            <field name="class_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="trainer_id" domain="[('branch_id', '=', branch_id)]"/>
                            <field name="facility_id" readonly="1"/>
                            <field name="class_type" readonly="1"/>
                            <field name="specialization" readonly="1"/>
                        </group>
                        <group string="Schedule">
                            <field name="date"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                            <field name="duration" readonly="1" widget="float_time"/>
                            <field name="datetime_start" readonly="1"/>
                            <field name="datetime_end" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Capacity">
                            <field name="max_capacity" readonly="1"/>
                            <field name="enrolled_count" readonly="1"/>
                            <field name="available_spots" readonly="1"/>
                            <field name="trainer_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Tab 1: Trainers (multi-trainer) -->
                        <page string="Trainers" name="trainers">
                            <field name="trainer_line_ids">
                                <list editable="bottom">
                                    <field name="trainer_id"
                                           domain="[('branch_id', '=', parent.branch_id)]"/>
                                    <field name="is_primary"/>
                                    <field name="is_substitute"/>
                                    <field name="role_note"/>
                                    <field name="commission_override"/>
                                    <field name="commission_pct"
                                           invisible="not commission_override"/>
                                    <field name="effective_commission_pct" readonly="1"/>
                                    <field name="revenue_share"/>
                                    <field name="commission_amount" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 2: Enrolled Members -->
                        <page string="Enrolled Members" name="members">
                            <field name="membership_ids"
                                   domain="[('branch_id', '=', branch_id), ('state', 'in', ('active', 'confirmed'))]">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="package_id"/>
                                    <field name="sessions_remaining"/>
                                    <field name="sessions_this_week"/>
                                    <field name="sessions_per_week"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 3: Attendance -->
                        <page string="Attendance" name="attendance">
                            <field name="attendance_ids">
                                <list editable="bottom"
                                      decoration-success="state == 'attended'"
                                      decoration-danger="state == 'absent'"
                                      decoration-warning="state == 'excused'">
                                    <field name="partner_id"/>
                                    <field name="membership_id"/>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'attended'"
                                           decoration-danger="state == 'absent'"
                                           decoration-warning="state == 'excused'"/>
                                    <button name="action_mark_attended" string="✓"
                                            type="object" class="btn-sm btn-success"
                                            invisible="state == 'attended'"/>
                                    <button name="action_mark_absent" string="✗"
                                            type="object" class="btn-sm btn-danger"
                                            invisible="state == 'absent'"/>
                                </list>
                            </field>
                        </page>
                        <!-- Tab 4: Commissions -->
                        <page string="Commissions" name="commission">
                            <field name="commission_ids">
                                <list>
                                    <field name="trainer_id"/>
                                    <field name="attended_count"/>
                                    <field name="session_revenue"/>
                                    <field name="commission_pct"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════
         SEARCH VIEW
    ════════════════════════════════════ -->
    <record id="view_club_session_search" model="ir.ui.view">
        <field name="name">club.session.search</field>
        <field name="model">club.session</field>
        <field name="arch" type="xml">
            <search string="Sessions">
                <field name="name"/>
                <field name="class_id"/>
                <field name="branch_id"/>
                <field name="trainer_id"/>
                <field name="date"/>
                <separator/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Full" name="full" domain="[('is_full', '=', True)]"/>
                <separator/>
                <filter string="Group Classes" name="group_type" domain="[('class_type', '=', 'group')]"/>
                <filter string="Private Sessions" name="private_type" domain="[('class_type', '=', 'private')]"/>
                <group>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Trainer" name="group_trainer" context="{'group_by': 'trainer_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Week" name="group_week" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════
         ACTION
    ════════════════════════════════════ -->
    <record id="action_club_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">club.session</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_club_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sessions yet!</p>
            <p>Generate sessions from confirmed classes, or drag &amp; drop to reschedule on the calendar.</p>
        </field>
    </record>

</odoo>
