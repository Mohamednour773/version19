<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_approval_sla" model="ir.cron">
        <field name="name">Approval Engine: SLA Reminders and Escalations</field>
        <field name="model_id" ref="model_universal_approval_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_sla()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_approval_notifications" model="ir.cron">
        <field name="name">Approval Engine: Notification Queue</field>
        <field name="model_id" ref="model_universal_approval_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>

