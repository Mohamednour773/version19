<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_factory_installation_list" model="ir.ui.view">
        <field name="name">factory.installation.list</field>
        <field name="model">factory.installation</field>
        <field name="arch" type="xml">
            <list string="Site Installations | تركيبات الموقع"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="sector_id"/>
                <field name="quantity_to_install"/>
                <field name="quantity_installed" sum="Installed"/>
                <field name="total_cost" widget="monetary" sum="Total Cost"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_factory_installation_form" model="ir.ui.view">
        <field name="name">factory.installation.form</field>
        <field name="model">factory.installation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start | بدء"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done | إنهاء"
                            type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel | إلغاء"
                            type="object"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset" string="Reset | إعادة"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Project | المشروع">
                            <field name="project_id"/>
                            <field name="sector_id"/>
                            <field name="user_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group string="Dates &amp; Quantities | التواريخ والكميات">
                            <field name="date"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="quantity_to_install"/>
                            <field name="quantity_installed"/>
                            <field name="uom_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accessories | الإكسسوارات">
                            <field name="accessory_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Finishing Materials | خامات التشطيب">
                            <field name="finishing_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_cost"/>
                                    <field name="total_cost" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Labor | العمالة">
                            <group>
                                <field name="labor_hours"/>
                                <field name="labor_rate"/>
                                <field name="labor_cost" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Site Expenses | مصاريف الموقع">
                            <field name="expense_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="expense_category"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="paid_by"/>
                                    <field name="receipt_number"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cost Summary | ملخص التكلفة">
                            <group>
                                <group>
                                    <field name="accessory_cost" widget="monetary"/>
                                    <field name="finishing_cost" widget="monetary"/>
                                </group>
                                <group>
                                    <field name="labor_cost" widget="monetary"/>
                                    <field name="expenses_cost" widget="monetary"/>
                                </group>
                            </group>
                            <group class="oe_subtotal_footer">
                                <field name="total_cost" widget="monetary"/>
                                <field name="cost_per_unit" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes | ملاحظات">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_factory_installation" model="ir.actions.act_window">
        <field name="name">Site Installations | تركيبات الموقع</field>
        <field name="res_model">factory.installation</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
