<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════════
         PDC Demo Checks — 20 checks in various states
         Tells a complete story for sales demos:

         RECEIVED (10):
           2 draft       — newly entered, waiting review
           2 registered  — waiting to deposit
           2 under_collection — deposited, waiting clearance
           2 cleared     — completed, historical
           1 bounced     — unsettled, needs action
           1 settled     — was bounced, now resolved

         ISSUED (8):
           2 registered  — waiting to print
           2 printed     — printed, waiting delivery
           2 delivered   — delivered to supplier, waiting payment
           1 paid        — historical
           1 cancelled   — reversed, with reason

         GUARANTEE (2):
           1 guarantee_received, registered  — active guarantee
           1 received + was_guarantee=True   — activated guarantee

         State is written directly so demo looks good in views even when
         the journal entries are not configured.
         ═══════════════════════════════════════════════════════════════════════ -->

