<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════════════
             RECORD RULES — Multi-Branch Data Isolation
             Admins see everything. Managers/Reception/Trainers
             only see records belonging to their branch(es).
        ═══════════════════════════════════════════════════════ -->

        <!-- ── club.branch ── -->
        <record id="rule_branch_manager" model="ir.rule">
            <field name="name">Branch: managers see own branch only</field>
            <field name="model_id" ref="model_club_branch"/>
            <field name="groups" eval="[(4, ref('club_management_system.group_club_manager'))]"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_branch_reception" model="ir.rule">
            <field name="name">Branch: reception sees own branch only</field>
            <field name="model_id" ref="model_club_branch"/>
            <field name="groups" eval="[(4, ref('club_management_system.group_club_reception'))]"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_branch_trainer" model="ir.rule">
            <field name="name">Branch: trainers see own branch only</field>
            <field name="model_id" ref="model_club_branch"/>
            <field name="groups" eval="[(4, ref('club_management_system.group_club_trainer'))]"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

