<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_waitlist_manager" model="ir.rule">
            <field name="name">Waitlist: Manager sees own branch</field>
            <field name="model_id" ref="model_club_session_waitlist"/>
            <field name="groups" eval="[(4, ref('club_management_system_final.group_club_manager'))]"/>
            <field name="domain_force">[('branch_id.user_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_waitlist_reception" model="ir.rule">
            <field name="name">Waitlist: Reception sees own branch</field>
            <field name="model_id" ref="model_club_session_waitlist"/>
            <field name="groups" eval="[(4, ref('club_management_system_final.group_club_reception'))]"/>
            <field name="domain_force">[('branch_id.user_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_waitlist_trainer" model="ir.rule">
            <field name="name">Waitlist: Trainer sees own sessions</field>
            <field name="model_id" ref="model_club_session_waitlist"/>
            <field name="groups" eval="[(4, ref('club_management_system_final.group_club_trainer'))]"/>
            <field name="domain_force">[('session_id.trainer_id.user_id', '=', user.id)]</field>
        </record>

        <record id="rule_notification_manager" model="ir.rule">
            <field name="name">Notifications: Manager sees own branch</field>
            <field name="model_id" ref="model_club_notification"/>
            <field name="groups" eval="[(4, ref('club_management_system_final.group_club_manager'))]"/>
            <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id.user_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_notification_reception" model="ir.rule">
            <field name="name">Notifications: Reception sees own branch</field>
            <field name="model_id" ref="model_club_notification"/>
            <field name="groups" eval="[(4, ref('club_management_system_final.group_club_reception'))]"/>
            <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id.user_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_overdue_manager" model="ir.rule">
            <field name="name">Overdue report: Manager sees own branch</field>
            <field name="model_id" ref="model_club_report_overdue"/>
            <field name="groups" eval="[(4, ref('club_management_system_final.group_club_manager'))]"/>
            <field name="domain_force">[('branch_id.user_ids', 'in', [user.id])]</field>
        </record>
    </data>
</odoo>
